  gerowong       Float?
  hollowVolume   Float?
  trimmingLength Float?
  trimmingVolume Float?
  netVolume      Float

  barcode    String?    @unique
  locationId String?
  location   Warehouse? @relation(fields: [locationId], references: [id])
  status     String     @default("AVAILABLE") // AVAILABLE, RESERVED, ASSIGNED_TO_INPUT, IN_PROCESS, CONSUMED, CANCELLED

