generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  timberPartais TimberPartai[]
  id            String         @id @default(uuid())
  tenant_id     String?
  tenant        Tenant?        @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name          String
  logo          String?
  address       String?
  phone         String?
  email         String?
  tax_number    String?
  timezone      String         @default("Asia/Jakarta")
  currency      String         @default("IDR")

  // Relations
  settings        CompanySetting?
  roles           Role[]
  users           User[]
  warehouses      Warehouse[]
  categories      Category[]
  units           Unit[]
  brands          Brand[]
  products        Product[]
  disposals       InventoryDisposal[]
  assetCategories AssetCategory[]
  assets          AssetMaster[]
  transactions    InventoryTransaction[]
  stockInTallies  StockInTally[]

  // Phase 5 Finance
  cash_accounts        CashAccount[]
  shifts               Shift[]
  finance_categories   FinanceCategory[]
  finance_transactions FinanceTransaction[]
  petty_cashes         PettyCash[]
  budgets              Budget[]
  reconciliations      Reconciliation[]

  // Phase 6 Accounting
  account_types       AccountType[]
  chart_of_accounts   ChartOfAccount[]
  journal_entries     JournalEntry[]
  fiscal_years        FiscalYear[]
  accounting_periods  AccountingPeriod[]
  journal_adjustments JournalAdjustment[]
  journal_reversals   JournalReversal[]

  // Phase 7 BI
  dashboard_layouts DashboardLayout[]
  dashboard_widgets DashboardWidget[]
  business_insights BusinessInsight[]

  // Phase 8 Reporting & Document
  report_schedules   ReportSchedule[]
  report_export_logs ReportExportLog[]
  documents          DocumentMaster[]

  // Phase 9 Automation
  workflows         WorkflowMaster[]
  approval_requests ApprovalRequest[]
  inbox_messages    InternalInbox[]
  user_tasks        UserTask[]
  notif_templates   NotificationTemplate[]
  automation_logs   AutomationLog[]

  // Phase 2 CRM
  customers    Customer[]
  sales_orders SalesOrder[]
  vouchers     Voucher[]

  // Phase 4 HR
  departments Department[]
  employees   Employee[]

  // Phase 10 AI
  ai_chats                 AiChatHistory[]
  pos_shifts               PosShift[]
  marketplace_integrations MarketplaceIntegration[]

  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  deleted_at              DateTime?
  Quotation               Quotation[]
  DeliveryOrder           DeliveryOrder[]
  Invoice                 Invoice[]
  Payment                 Payment[]
  PurchaseOrder           PurchaseOrder[]
  GoodsReceipt            GoodsReceipt[]
  LeaveRequest            LeaveRequest[]
  Payroll                 Payroll[]
  Lead                    Lead[]
  Opportunity             Opportunity[]
  CrmActivity             CrmActivity[]
  EcommerceCart           EcommerceCart[]
  InventoryCostLayer      InventoryCostLayer[]
  CostLayerConsumption    CostLayerConsumption[]
  timberSpecies           TimberSpecies[]
  timberGrades            TimberGrade[]
  timberSources           TimberSource[]
  vehicles                Vehicle[]
  drivers                 Driver[]
  productionProcesses     ProductionProcess[]
  timberPurchases         TimberPurchase[]
  timberShipments         TimberShipment[]
  timberStockOpnames      TimberStockOpname[]
  timberStockReservations TimberStockReservation[]
  timberVariants          TimberVariant[]

  exportShipments     ExportShipment[]
  timberPackings      TimberPacking[]
  StockTransformation StockTransformation[]
  Netting             Netting[]
  PurchaseReturn      PurchaseReturn[]
  SalesReturn         SalesReturn[]
  batchReclassifications TimberBatchReclassification[]
}

model CompanySetting {
  id                   String  @id @default(uuid())
  company_id           String  @unique
  company              Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency             String  @default("IDR")
  timezone             String  @default("Asia/Jakarta")
  language             String  @default("id")
  tax_percentage       Float   @default(11.0)
  logo                 String?
  invoice_prefix       String  @default("INV-")
  barcode_prefix       String  @default("BRC-")
  default_warehouse_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Role {
  id          String   @id @default(uuid())
  company_id  String?
  company     Company? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  description String?
  is_system   Boolean  @default(false)
  is_active   Boolean  @default(true)

  permissions RolePermission[]
  users       User[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, name])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model RolePermission {
  id            String     @id @default(uuid())
  role_id       String
  role          Role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())

  @@unique([role_id, permission_id])
}

model User {
  id                 String    @id @default(uuid())
  company_id         String?
  company            Company?  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role_id            String?
  role               Role?     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  username           String    @unique
  name               String
  email              String?   @unique
  phone              String?
  password           String
  avatar             String?
  status             Boolean   @default(true)
  last_login         DateTime?
  accessible_modules String[]  @default([])

  created_transactions  InventoryTransaction[] @relation("CreatedTransactions")
  approved_transactions InventoryTransaction[] @relation("ApprovedTransactions")
  stock_movements       StockMovement[]

  // EAM Relations
  user_assets               AssetMaster[]     @relation("UserAssets")
  performed_asset_histories AssetHistory[]    @relation("PerformedAssetHistories")
  created_asset_locations   AssetLocation[]   @relation("CreatedAssetLocations")
  assigned_assets           AssetAssignment[] @relation("AssignedAssets")
  borrowed_assets           AssetBorrowing[]  @relation("BorrowedAssets")
  approved_asset_borrowings AssetBorrowing[]  @relation("ApprovedAssetBorrowings")
  created_maintenance_logs  MaintenanceLog[]  @relation("CreatedMaintenanceLogs")
  assigned_work_orders      WorkOrder[]       @relation("AssignedWorkOrders")
  created_work_orders       WorkOrder[]       @relation("CreatedWorkOrders")
  uploaded_asset_documents  AssetDocument[]   @relation("UploadedAssetDocuments")

  // Finance Relations
  created_finance_tx       FinanceTransaction[] @relation("CreatedFinanceTx")
  approved_finance_tx      FinanceTransaction[] @relation("ApprovedFinanceTx")
  uploaded_finance_docs    FinanceDocument[]    @relation("UploadedFinanceDocs")
  petty_cash_accounts      PettyCash[]          @relation("PettyCashEmployee")
  approved_reconciliations Reconciliation[]     @relation("ApprovedReconciliations")

  // Accounting Relations
  created_journals     JournalEntry[]      @relation("CreatedJournals")
  approved_journals    JournalEntry[]      @relation("ApprovedJournals")
  closed_fiscal_years  FiscalYear[]        @relation("ClosedFiscalYears")
  created_adjustments  JournalAdjustment[] @relation("CreatedAdjustments")
  approved_adjustments JournalAdjustment[] @relation("ApprovedAdjustments")
  created_reversals    JournalReversal[]   @relation("CreatedReversals")

  // BI Relations
  dashboard_layouts DashboardLayout[] @relation("DashboardLayouts")
  dashboard_widgets DashboardWidget[] @relation("DashboardWidgets")

  // Phase 8 Relations
  scheduled_reports      ReportSchedule[]    @relation("ScheduledReports")
  export_logs            ReportExportLog[]   @relation("ExportLogs")
  uploaded_documents     DocumentMaster[]    @relation("UploadedDocuments")
  uploaded_document_vers DocumentVersion[]   @relation("UploadedDocumentVersions")
  created_share_links    DocumentShareLink[] @relation("CreatedShareLinks")

  // Phase 9 Relations
  pending_approvals ApprovalRequest[] @relation("PendingApprovals")
  approval_history  ApprovalLog[]     @relation("ApprovalHistory")
  inbox_messages    InternalInbox[]   @relation("UserInbox")
  tasks             UserTask[]        @relation("UserTasks")
  // Phase 10 AI
  ai_chats          AiChatHistory[]   @relation("UserAiChats")

  // POS
  pos_shifts PosShift[] @relation("UserPosShifts")

  created_disposals  InventoryDisposal[]   @relation("DisposalCreator")
  approved_disposals InventoryDisposal[]   @relation("DisposalApprover")
  // RBAC Warehouse Access
  warehouse_accesses UserWarehouseAccess[]

  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  deleted_at          DateTime?
  StockTransformation StockTransformation[]
}

model Warehouse {
  rawLogs               RawLog[]
  trimmedLogs           TrimmedLog[]
  inputLogs             InputLog[]
  manufacturing_orders  ManufacturingOrder[]
  material_reservations MaterialReservation[]
  timberDeliveryItems   TimberDeliveryNoteItem[]
  id                    String                   @id @default(uuid())
  company_id            String
  company               Company                  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                  String
  name                  String
  address               String?
  pic                   String?
  phone                 String?
  description           String?
  status                Boolean                  @default(true)

  transactions_as_origin InventoryTransaction[] @relation("TransactionWarehouse")
  transactions_as_target InventoryTransaction[] @relation("TransactionTargetWarehouse")
  stock_movements        StockMovement[]
  stockInTallies         StockInTally[]
  warehouse_stocks       WarehouseStock[]
  sawnOutputs            SawnTimberOutput[]
  timberStocks           TimberStock[]
  transfersFrom          StockTransfer[]        @relation("TransferFromLocation")
  transfersTo            StockTransfer[]        @relation("TransferToLocation")
  adjustments            StockAdjustment[]
  finance_transactions   FinanceTransaction[]
  customers              Customer[]
  employees              Employee[]
  pos_shifts             PosShift[]

  disposals     InventoryDisposal[]
  user_accesses UserWarehouseAccess[]

  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @updatedAt
  deleted_at                 DateTime?
  PurchaseOrder              PurchaseOrder[]
  GoodsReceipt               GoodsReceipt[]
  InventoryCostLayer         InventoryCostLayer[]
  locations                  Location[]
  productionOutputs          ProductionProcessOutput[]
  timberPurchases            TimberPurchase[]
  timberShipments            TimberShipment[]            @relation("ShipmentOriginWarehouse")
  timberShipmentsReceived    TimberShipment[]            @relation("ShipmentDestinationWarehouse")
  timberStockOpnames         TimberStockOpname[]
  timberStockReservations    TimberStockReservation[]
  timberPackings             TimberPacking[]
  fulfillmentSalesOrderItems TimberSalesOrderItem[]
  StockTransformationInput   StockTransformationInput[]
  StockTransformationOutput  StockTransformationOutput[]
  PurchaseReturn             PurchaseReturn[]
  SalesReturn                SalesReturn[]
  batchReclassifications     TimberBatchReclassification[]

  @@unique([company_id, code])
  @@index([company_id])
}

model UserWarehouseAccess {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_at   DateTime  @default(now())

  @@unique([user_id, warehouse_id])
}

model Category {
  id         String     @id @default(uuid())
  company_id String
  company    Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[] @relation("CategoryHierarchy")
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Unit {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Brand {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Product {
  timberVariants            TimberVariant[]
  disposalItems             InventoryDisposalItem[]
  purchase_request_items    PurchaseRequestItem[]
  boms                      Bom[]
  bom_items                 BomItem[]
  manufacturing_orders      ManufacturingOrder[]
  manufacturing_order_items ManufacturingOrderItem[]
  quality_control_points    QualityControlPoint[]
  material_reservations     MaterialReservation[]
  stockInTallyItems         StockInTallyItem[]
  id                        String                   @id @default(uuid())
  company_id                String
  company                   Company                  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id               String?
  category                  Category?                @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand_id                  String?
  brand                     Brand?                   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit_id                   String
  unit                      Unit                     @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id               String?
  supplier                  Customer?                @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  code           String
  barcode        String?
  name           String
  description    String?
  purchase_price Float
  selling_price  Float
  minimum_stock  Int     @default(0)
  weight         Float?
  length         Float?
  width          Float?
  height         Float?
  image          String?
  status         Boolean @default(true)

  // Ecommerce Fields
  is_published         Boolean @default(false)
  ecommerce_slug       String?
  seo_title            String?
  seo_description      String?
  ecommerce_sort_order Int     @default(0)

  images               ProductImage[]
  documents            ProductDocument[]
  transaction_items    InventoryTransactionItem[]
  stock_movements      StockMovement[]
  warehouse_stocks     WarehouseStock[]
  sales_order_items    SalesOrderItem[]
  ecommerce_cart_items EcommerceCartItem[]

  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  deleted_at                DateTime?
  QuotationItem             QuotationItem[]
  DeliveryOrderItem         DeliveryOrderItem[]
  InvoiceItem               InvoiceItem[]
  PurchaseOrderItem         PurchaseOrderItem[]
  GoodsReceiptItem          GoodsReceiptItem[]
  InventoryCostLayer        InventoryCostLayer[]
  quality_checks            QualityCheck[]
  StockTransformationInput  StockTransformationInput[]
  StockTransformationOutput StockTransformationOutput[]
  PurchaseReturnItem        PurchaseReturnItem[]
  SalesReturnItem           SalesReturnItem[]

  @@unique([company_id, code])
  @@unique([company_id, barcode])
  @@index([company_id])
}

model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  image_url  String
  is_primary Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ProductDocument {
  id            String  @id @default(uuid())
  product_id    String
  product       Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_url  String
  document_type String
  title         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

// =======================
// ENTERPRISE ASSET MANAGEMENT (PHASE 4)
// =======================

model AssetCategory {
  id         String          @id @default(uuid())
  company_id String
  company    Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?
  parent     AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   AssetCategory[] @relation("AssetCategoryHierarchy")

  name        String
  code        String?
  description String?
  icon        String?
  color       String?
  status      Boolean @default(true)

  assets AssetMaster[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model AssetMaster {
  id           String        @id @default(uuid())
  company_id   String
  company      Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id  String
  category     AssetCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String?

  assigned_user_id String?
  assigned_user    User?   @relation("UserAssets", fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  asset_code    String
  asset_name    String
  brand         String?
  model         String?
  serial_number String?
  barcode       String? @unique
  qr_code       String? @unique

  purchase_date  DateTime?
  purchase_price Float     @default(0)
  supplier_id    String?

  current_value       Float   @default(0)
  useful_life         Int? // In months
  depreciation_method String? // Straight Line, Declining Balance

  location  String?
  status    String // ACTIVE, BORROWED, MAINTENANCE, BROKEN, DISPOSED, SOLD, LOST
  condition String // EXCELLENT, GOOD, FAIR, DAMAGED, BROKEN

  warranty_until DateTime?
  notes          String?
  cost_source    String? // MANUAL, LATEST_PURCHASE, CONFIGURED_DEFAULT
  image          String?
  manual_file    String?
  invoice_file   String?

  is_capitalized                      Boolean               @default(false)
  capitalization_date                 DateTime?
  residual_value                      Float                 @default(0)
  accumulated_depreciation            Float                 @default(0)
  asset_account_id                    String?
  accumulated_depreciation_account_id String?
  depreciation_expense_account_id     String?
  disposal_date                       DateTime?
  disposal_proceeds                   Float                 @default(0)
  asset_depreciations                 AssetDepreciation[]
  histories                           AssetHistory[]
  locations                           AssetLocation[]
  assignments                         AssetAssignment[]
  borrowings                          AssetBorrowing[]
  maintenances                        MaintenanceLog[]
  schedules                           MaintenanceSchedule[]
  documents                           AssetDocument[]
  depreciations                       DepreciationLog[]
  work_orders                         WorkOrder[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, asset_code])
}

model AssetHistory {
  id           String      @id @default(uuid())
  asset_id     String
  asset        AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action       String
  before_data  Json?
  after_data   Json?
  performed_by String
  user         User        @relation("PerformedAssetHistories", fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  performed_at DateTime @default(now())
}

model AssetLocation {
  id            String      @id @default(uuid())
  asset_id      String
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from_location String?
  to_location   String
  from_user     String?
  to_user       String?
  notes         String?

  created_by String
  user       User     @relation("CreatedAssetLocations", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moved_at   DateTime @default(now())
}

model AssetAssignment {
  id       String      @id @default(uuid())
  asset_id String
  asset    AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id  String
  user     User        @relation("AssignedAssets", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assigned_at DateTime  @default(now())
  returned_at DateTime?
  status      String // ACTIVE, RETURNED
  notes       String?
}

model AssetBorrowing {
  id         String      @id @default(uuid())
  asset_id   String
  asset      AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  borrower   String
  user       User        @relation("BorrowedAssets", fields: [borrower], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department String?

  borrow_date        DateTime
  return_date        DateTime
  actual_return_date DateTime?

  status      String // PENDING, BORROWED, RETURNED, OVERDUE, CANCELLED
  approved_by String?
  approver    User?   @relation("ApprovedAssetBorrowings", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model MaintenanceLog {
  id               String      @id @default(uuid())
  asset_id         String
  asset            AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_type String // Preventive, Corrective, Emergency, Calibration, Inspection
  vendor           String?
  cost             Float       @default(0)
  description      String?

  before_photo String?
  after_photo  String?
  invoice      String?

  service_date      DateTime
  next_service_date DateTime?
  technician        String?
  status            String // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  created_by String
  user       User   @relation("CreatedMaintenanceLogs", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model MaintenanceSchedule {
  id             String      @id @default(uuid())
  asset_id       String
  asset          AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interval_type  String // DAYS, MONTHS, YEARS, USAGE_HOURS, KM
  interval_value Int

  last_schedule DateTime?
  next_schedule DateTime
  status        String // ACTIVE, PAUSED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model WorkOrder {
  id               String      @id @default(uuid())
  asset_id         String
  asset            AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wo_number        String      @unique
  title            String
  description      String?
  maintenance_type String
  priority         String // LOW, MEDIUM, HIGH, CRITICAL

  assigned_to String?
  technician  User?   @relation("AssignedWorkOrders", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)

  estimated_hours Float?
  actual_hours    Float?
  cost            Float  @default(0)

  status String // OPEN, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED

  started_at   DateTime?
  completed_at DateTime?

  created_by String
  user       User   @relation("CreatedWorkOrders", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
  company_id     String?
}

model AssetDocument {
  id            String      @id @default(uuid())
  asset_id      String
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_type String // Manual, Invoice, Warranty, Certificate, Photo, License, Other
  file_name     String
  file_url      String

  uploaded_by String
  user        User   @relation("UploadedAssetDocuments", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  uploaded_at DateTime @default(now())
}

model DepreciationLog {
  id            String      @id @default(uuid())
  asset_id      String
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period        String // e.g. "2026-07"
  opening_value Float
  depreciation  Float
  closing_value Float

  created_at DateTime @default(now())
}

model Netting {
  id             String   @id @default(uuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id])
  partner_id     String
  partner        Customer @relation(fields: [partner_id], references: [id])
  netting_number String
  date           DateTime
  amount         Float
  notes          String?
  status         String   @default("COMPLETED") // COMPLETED, REVERSED
  created_by     String?

  allocations NettingAllocation[]
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  @@unique([company_id, netting_number])
}

model NettingAllocation {
  id         String  @id @default(uuid())
  netting_id String
  netting    Netting @relation(fields: [netting_id], references: [id], onDelete: Cascade)
  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: NoAction)
  type       String // "AR" or "AP"
  amount     Float

  created_at DateTime @default(now())
}

model AuditLog {
  id         String  @id @default(uuid())
  company_id String?
  user_id    String?
  ip_address String?
  browser    String?
  device     String?

  action    String
  entity    String
  entity_id String?

  before_data Json?
  after_data  Json?

  created_at DateTime @default(now())
}

// =======================
// INVENTORY & STOCK LEDGER (PHASE 3)
// =======================

model InventoryTransaction {
  id                  String     @id @default(uuid())
  company_id          String
  company             Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_no      String
  transaction_type    String // IN, OUT, TRANSFER, ADJUSTMENT, OPNAME, RETURN
  warehouse_id        String
  warehouse           Warehouse  @relation("TransactionWarehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target_warehouse_id String?
  target_warehouse    Warehouse? @relation("TransactionTargetWarehouse", fields: [target_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reference_type      String?
  reference_id        String?
  status              String // Draft, Pending, Approved, Rejected, Cancelled
  transaction_date    DateTime
  notes               String?

  created_by    String
  user_created  User      @relation("CreatedTransactions", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?
  user_approved User?     @relation("ApprovedTransactions", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items InventoryTransactionItem[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, transaction_no])
  @@index([company_id])
}

model InventoryTransactionItem {
  id             String               @id @default(uuid())
  transaction_id String
  transaction    InventoryTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id     String
  product        Product              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty            Float
  system_qty     Float?
  counted_qty    Float?
  difference     Float?
  unit_cost      Float                @default(0)
  subtotal       Float
  batch_number   String?
  expired_date   DateTime?
  notes          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model StockMovement {
  id           String    @id @default(uuid())
  company_id   String
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id   String
  product      Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transaction_type String // IN, OUT, TRANSFER, ADJUSTMENT, OPNAME, RETURN
  transaction_id   String?
  movement_type    String // IN, OUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_PLUS, ADJUSTMENT_MINUS, OPNAME, RETURN

  qty_in        Float @default(0)
  qty_out       Float @default(0)
  balance_after Float @default(0)

  unit_cost  Float @default(0)
  total_cost Float @default(0)

  batch_number     String?
  expired_date     DateTime?
  reference_number String?
  remarks          String?

  created_by String
  user       User   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at           DateTime               @default(now())
  InventoryCostLayer   InventoryCostLayer[]
  CostLayerConsumption CostLayerConsumption[]
}

model WarehouseStock {
  id           String    @id @default(uuid())
  company_id   String
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id   String
  product      Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  current_stock   Float @default(0)
  reserved_stock  Float @default(0)
  available_stock Float @default(0)

  updated_at DateTime @updatedAt

  @@unique([company_id, warehouse_id, product_id])
  @@index([company_id])
}

// =======================
// FINANCE MANAGEMENT (PHASE 5)
// =======================

model CashAccount {
  id                  String          @id @default(uuid())
  company_id          String
  company             Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                String
  name                String
  account_type        String // Cash, Bank, Petty Cash, Digital Wallet
  chart_of_account_id String?
  chart_of_account    ChartOfAccount? @relation(fields: [chart_of_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency            String          @default("IDR")

  opening_balance Float   @default(0)
  current_balance Float   @default(0)
  status          Boolean @default(true)

  transactions    FinanceTransaction[]
  reconciliations Reconciliation[]
  petty_cashes    PettyCash[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, code])
}

model FinanceCategory {
  id         String            @id @default(uuid())
  company_id String
  company    Company           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?
  parent     FinanceCategory?  @relation("FinanceCatHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   FinanceCategory[] @relation("FinanceCatHierarchy")
  name       String
  type       String // Income, Expense, Transfer, Adjustment
  color      String?
  icon       String?
  status     Boolean           @default(true)

  items       FinanceTransactionItem[]
  budgets     Budget[]
  ExpenseItem ExpenseItem[]
}

model FinanceTransaction {
  id               String      @id @default(uuid())
  company_id       String
  company          Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id     String?
  warehouse        Warehouse?  @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_no   String
  transaction_type String // Cash In, Cash Out, Transfer, Expense, Income, Adjustment
  cash_account_id  String
  cash_account     CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reference_type   String?
  reference_id     String?
  transaction_date DateTime
  status           String // Draft, Pending, Approved, Rejected, Cancelled, Reversed
  description      String?
  total_amount     Float    @default(0)

  created_by    String
  user_created  User      @relation("CreatedFinanceTx", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?
  user_approved User?     @relation("ApprovedFinanceTx", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items     FinanceTransactionItem[]
  documents FinanceDocument[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, transaction_no])
}

model FinanceTransactionItem {
  id             String             @id @default(uuid())
  transaction_id String
  transaction    FinanceTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id    String
  category       FinanceCategory    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount         Float
  tax            Float              @default(0)
  description    String?
}

model FinanceDocument {
  id             String             @id @default(uuid())
  transaction_id String
  transaction    FinanceTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_type  String
  file_url       String

  uploaded_by String
  user        User     @relation("UploadedFinanceDocs", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploaded_at DateTime @default(now())
}

model PettyCash {
  id              String      @id @default(uuid())
  company_id      String
  company         Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cash_account_id String
  cash_account    CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee_id     String
  employee        User        @relation("PettyCashEmployee", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  opening_balance Float
  current_balance Float
  status          String // ACTIVE, CLOSED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Budget {
  id            String          @id @default(uuid())
  company_id    String
  company       Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id   String
  category      FinanceCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department_id String?
  period        String // e.g. "2026-07"

  budget_amount    Float
  used_amount      Float  @default(0)
  remaining_amount Float
  status           String // ACTIVE, EXHAUSTED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Reconciliation {
  id              String      @id @default(uuid())
  company_id      String
  company         Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cash_account_id String
  cash_account    CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period          String // e.g. "2026-07"

  system_balance   Float
  physical_balance Float
  difference       Float

  approved_by String?
  approver    User?   @relation("ApprovedReconciliations", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String // PENDING, APPROVED, ADJUSTED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

// =======================
// ACCOUNTING & GENERAL LEDGER (PHASE 6)
// =======================

model AccountType {
  id             String  @id @default(uuid())
  company_id     String
  company        Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code           String
  name           String
  normal_balance String // Debit, Credit
  description    String?

  accounts ChartOfAccount[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, code])
}

model ChartOfAccount {
  id              String           @id @default(uuid())
  company_id      String
  company         Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id       String?
  parent          ChartOfAccount?  @relation("CoA_Hierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        ChartOfAccount[] @relation("CoA_Hierarchy")
  account_type_id String
  account_type    AccountType      @relation(fields: [account_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  account_code       String
  account_name       String
  currency           String  @default("IDR")
  allow_manual_entry Boolean @default(true)
  is_header          Boolean @default(false)
  status             Boolean @default(true)

  journal_items JournalEntryItem[]

  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  deleted_at  DateTime?
  CashAccount CashAccount[]

  @@unique([company_id, account_code])
}

model JournalEntry {
  id              String   @id @default(uuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_no      String
  reference_type  String // INVENTORY, ASSET, FINANCE, MANUAL
  reference_id    String?
  idempotency_key String?  @unique
  journal_date    DateTime
  description     String?
  status          String // Draft, Pending, Approved, Posted, Closed

  created_by    String
  user_created  User      @relation("CreatedJournals", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?
  user_approved User?     @relation("ApprovedJournals", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items          JournalEntryItem[]
  adjustments    JournalAdjustment[]
  reversals_orig JournalReversal[]   @relation("OriginalJournal")
  reversals_rev  JournalReversal[]   @relation("ReverseJournal")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, journal_no])
}

model JournalEntryItem {
  id               String         @id @default(uuid())
  journal_entry_id String
  journal_entry    JournalEntry   @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account_id       String
  account          ChartOfAccount @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?
}

model FiscalYear {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  year       Int
  start_date DateTime
  end_date   DateTime
  status     String // OPEN, CLOSED

  closed_at DateTime?
  closed_by String?
  closer    User?     @relation("ClosedFiscalYears", fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())

  @@unique([company_id, year])
}

model AccountingPeriod {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  month      Int
  year       Int
  start_date DateTime
  end_date   DateTime
  status     String // OPEN, CLOSED

  created_at DateTime @default(now())

  @@unique([company_id, month, year])
}

model JournalAdjustment {
  id               String       @id @default(uuid())
  company_id       String
  company          Company      @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entry_id String
  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason           String

  created_by  String
  creator     User    @relation("CreatedAdjustments", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by String?
  approver    User?   @relation("ApprovedAdjustments", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

model JournalReversal {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  original_journal_id String
  original_journal    JournalEntry @relation("OriginalJournal", fields: [original_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reverse_journal_id  String
  reverse_journal     JournalEntry @relation("ReverseJournal", fields: [reverse_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reason     String
  created_by String
  creator    User   @relation("CreatedReversals", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

// =======================
// DASHBOARD & BUSINESS INTELLIGENCE (PHASE 7)
// =======================

model DashboardLayout {
  id          String  @id @default(uuid())
  company_id  String
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id     String
  user        User    @relation("DashboardLayouts", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String // "Manager Layout", "Finance Default"
  is_default  Boolean @default(false)
  layout_data Json // JSON array of widget coordinates and sizes

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, name])
}

model DashboardWidget {
  id          String  @id @default(uuid())
  company_id  String
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  widget_type String // e.g. "LineChart", "PieChart", "KPICard"
  data_source String // e.g. "api/analytics/net-profit"
  title       String
  config      Json? // Optional filter configs saved by user

  user_id String
  user    User   @relation("DashboardWidgets", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model BusinessInsight {
  id           String  @id @default(uuid())
  company_id   String
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  insight_type String // "Warning", "Recommendation", "Achievement"
  title        String
  description  String
  module       String // "Inventory", "Asset", "Finance", "Accounting"
  priority     String // "LOW", "MEDIUM", "HIGH"
  status       String // "UNREAD", "READ", "RESOLVED"

  created_at DateTime @default(now())
}

// =======================
// REPORTING & DOCUMENT CENTER (PHASE 8)
// =======================

model ReportSchedule {
  id          String  @id @default(uuid())
  company_id  String
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  report_type String // "Inventory", "Finance", "Accounting"
  cron_expr   String // e.g. "0 8 * * *"
  recipients  String // comma separated emails
  status      Boolean @default(true)
  created_by  String
  user        User    @relation("ScheduledReports", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ReportExportLog {
  id           String  @id @default(uuid())
  company_id   String
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_type  String
  format       String // "PDF", "EXCEL", "CSV"
  status       String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  file_url     String?
  error_msg    String?
  requested_by String
  user         User    @relation("ExportLogs", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  started_at   DateTime  @default(now())
  completed_at DateTime?
}

model DocumentMaster {
  id          String  @id @default(uuid())
  company_id  String
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_no String  @unique
  title       String
  category    String // "Invoice", "Purchase Order", "Contract"
  tags        String? // comma separated, e.g. "Urgent,Finance"
  status      String // "ACTIVE", "ARCHIVED"

  uploaded_by String
  user        User   @relation("UploadedDocuments", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  versions DocumentVersion[]
  shares   DocumentShareLink[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, document_no])
}

model DocumentVersion {
  id                 String         @id @default(uuid())
  document_master_id String
  document_master    DocumentMaster @relation(fields: [document_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version_number     Int
  file_url           String
  file_size          Int // in bytes
  mime_type          String
  uploaded_by        String
  user               User           @relation("UploadedDocumentVersions", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

model DocumentShareLink {
  id                 String         @id @default(uuid())
  document_master_id String
  document_master    DocumentMaster @relation(fields: [document_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  token              String         @unique
  password_hash      String?
  expired_at         DateTime

  created_by String
  user       User     @relation("CreatedShareLinks", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_at DateTime @default(now())
}

// =======================
// WORKFLOW AUTOMATION PLATFORM (PHASE 9)
// =======================

model WorkflowMaster {
  id            String  @id @default(uuid())
  company_id    String
  company       Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name          String
  description   String?
  module        String // "Inventory", "Finance", "Asset"
  trigger_event String // e.g. "InventoryTransaction.Created"
  status        Boolean @default(true)
  version       Int     @default(1)

  nodes WorkflowNode[]
  edges WorkflowEdge[]
  logs  AutomationLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model WorkflowNode {
  id                 String         @id @default(uuid())
  workflow_master_id String
  workflow_master    WorkflowMaster @relation(fields: [workflow_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  node_type          String // "Start", "Condition", "Approval", "Notification", "Task", "End"
  node_name          String
  config             Json // Rules, Emails, Roles, Conditions (AND/OR/>/<)
  ui_position        Json // {x: 100, y: 200} for Visual Editor

  created_at DateTime @default(now())
}

model WorkflowEdge {
  id                 String         @id @default(uuid())
  workflow_master_id String
  workflow_master    WorkflowMaster @relation(fields: [workflow_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_node_id     String
  target_node_id     String
  condition_label    String? // e.g. "True", "False", "Approved", "Rejected"

  created_at DateTime @default(now())
}

model ApprovalRequest {
  id           String  @id @default(uuid())
  company_id   String
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module       String // "Finance", "Inventory"
  reference_id String // ID dari transaksi
  title        String
  description  String?
  status       String // "PENDING", "APPROVED", "REJECTED", "ESCALATED"

  current_step  Int     @default(1)
  assigned_role String? // Jika approval berdasarkan role
  assigned_user String? // Jika approval spesifik ke user
  assignee      User?   @relation("PendingApprovals", fields: [assigned_user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  logs ApprovalLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ApprovalLog {
  id                  String          @id @default(uuid())
  approval_request_id String
  approval_request    ApprovalRequest @relation(fields: [approval_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action              String // "APPROVED", "REJECTED", "ESCALATED"
  notes               String?

  acted_by String
  actor    User     @relation("ApprovalHistory", fields: [acted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acted_at DateTime @default(now())
}

model InternalInbox {
  id           String  @id @default(uuid())
  company_id   String
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id      String
  user         User    @relation("UserInbox", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message_type String // "Approval", "Task", "Notification", "Reminder", "Announcement"
  title        String
  content      String
  reference_id String?
  is_read      Boolean @default(false)

  created_at DateTime @default(now())
}

model UserTask {
  id           String    @id @default(uuid())
  company_id   String
  company      Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_to  String
  assignee     User      @relation("UserTasks", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title        String
  description  String?
  due_date     DateTime?
  status       String // "TODO", "IN_PROGRESS", "DONE", "OVERDUE"
  priority     String // "LOW", "MEDIUM", "HIGH"
  reference_id String? // ID dari modul terkait

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model NotificationTemplate {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String
  channel    String // "EMAIL", "WHATSAPP", "IN_APP", "SLACK", "WEBHOOK"
  subject    String?
  body       String // Support variables {{user}}, {{amount}}

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, name, channel])
}

model AutomationLog {
  id                 String          @id @default(uuid())
  company_id         String
  company            Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow_master_id String?
  workflow_master    WorkflowMaster? @relation(fields: [workflow_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_name         String
  status             String // "SUCCESS", "FAILED", "RETRIED"
  error_msg          String?
  duration_ms        Int             @default(0)

  created_at DateTime @default(now())
}

// =======================
// PLATFORM SERVICES & SAAS (PHASE 10)
// =======================

model Tenant {
  id     String  @id @default(uuid())
  name   String
  domain String? @unique // e.g. "client1.erp.com"
  status String // "ACTIVE", "SUSPENDED", "CANCELLED"

  companies    Company[]
  subscription TenantSubscription?
  api_tokens   ApiToken[]
  plugins      InstalledPlugin[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model SubscriptionPlan {
  id            String @id @default(uuid())
  name          String // "Starter", "Professional", "Enterprise"
  price_monthly Float
  price_yearly  Float

  max_users        Int
  max_warehouses   Int
  max_assets       Int
  storage_limit_mb Int
  api_limit_day    Int
  ai_credits_mo    Int

  subscriptions TenantSubscription[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model TenantSubscription {
  id        String           @id @default(uuid())
  tenant_id String           @unique
  tenant    Tenant           @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_id   String
  plan      SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  billing_cycle String // "MONTHLY", "YEARLY"
  status        String // "TRIAL", "ACTIVE", "EXPIRED", "CANCELLED"
  start_date    DateTime
  end_date      DateTime

  invoices BillingInvoice[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model BillingInvoice {
  id                  String             @id @default(uuid())
  subscription_id     String
  subscription        TenantSubscription @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_no          String             @unique
  amount              Float
  status              String // "UNPAID", "PAID", "FAILED"
  due_date            DateTime
  paid_at             DateTime?
  payment_method      String?
  payment_gateway_ref String?

  created_at DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(uuid())
  tenant_id  String
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String
  token_hash String    @unique
  scopes     String // e.g. "read:inventory, write:finance"
  last_used  DateTime?

  created_at DateTime @default(now())
}

model InstalledPlugin {
  id        String @id @default(uuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plugin_id String // Ref to Marketplace Global DB
  status    String // "ACTIVE", "INACTIVE"
  config    Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, plugin_id])
}

// =======================
// CRM & SALES ORDERS (PHASE 2)
// =======================

model Customer {
  roles        String[]   @default(["CUSTOMER"])
  id           String     @id @default(uuid())
  company_id   String
  company      Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String?
  warehouse    Warehouse? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code         String
  name         String
  phone        String?
  email        String?
  address      String?
  point        Int        @default(0)
  level        String     @default("Bronze") // Bronze, Silver, Gold, Platinum
  status       Boolean    @default(true)

  company_name     String?
  payments         Payment[]
  billing_address  String?
  delivery_address String?
  tax_id           String?

  orders               SalesOrder[]
  quotations           Quotation[]
  invoices_as_customer Invoice[]          @relation("InvoiceCustomer")
  invoices_as_supplier Invoice[]          @relation("InvoiceSupplier")
  timberSalesOrders    TimberSalesOrder[]

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  deleted_at      DateTime?
  Opportunity     Opportunity[]
  CrmActivity     CrmActivity[]
  timberShipments TimberShipment[]
  Product         Product[]
  PurchaseOrder   PurchaseOrder[]
  GoodsReceipt    GoodsReceipt[]
  SupplierProduct SupplierProduct[]
  Netting         Netting[]
  PurchaseReturn  PurchaseReturn[]
  SalesReturn     SalesReturn[]

  @@unique([company_id, code])
}

model Voucher {
  id             String   @id @default(uuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code           String
  name           String
  discount_type  String // PERCENTAGE, NOMINAL
  discount_value Float
  min_purchase   Float?
  max_discount   Float?
  quota          Int      @default(0)
  used_count     Int      @default(0)
  valid_from     DateTime
  valid_until    DateTime
  status         Boolean  @default(true) // Active or Inactive

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, code])
}

model SalesOrder {
  id             String    @id @default(uuid())
  company_id     String
  company        Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_number   String
  order_date     DateTime
  status         String // DRAFT, PENDING, COMPLETED, CANCELLED
  total_amount   Float
  notes          String?
  pos_shift_id   String?
  warehouse_id   String?
  pos_shift      PosShift? @relation(fields: [pos_shift_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_method String? // Cash, QRIS, Debit, Credit, Transfer, Split
  payment_status String? // UNPAID, PARTIAL, PAID

  allocations PaymentAllocation[]

  channel              String?       @default("B2B") // POS, B2B, ECOMMERCE
  ecommerce_session_id String? // Idempotency key for checkout
  salesReturns         SalesReturn[]

  quotation_id     String?
  quotation        Quotation? @relation(fields: [quotation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billing_address  String?
  delivery_address String?
  delivery_status  String? // PENDING, PARTIAL, DELIVERED
  invoice_status   String? // PENDING, PARTIAL, INVOICED

  items      SalesOrderItem[]
  deliveries DeliveryOrder[]
  invoices   Invoice[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, order_number])
  @@unique([company_id, ecommerce_session_id])
  @@index([company_id])
}

model SalesOrderItem {
  id             String            @id @default(uuid())
  sales_order_id String
  sales_order    SalesOrder        @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id     String
  product        Product           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty            Float
  system_qty     Float?
  counted_qty    Float?
  difference     Int?
  unit_price     Float
  subtotal       Float
  returned_qty   Float             @default(0)
  salesReturns   SalesReturnItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model PosShift {
  id           String    @id @default(uuid())
  company_id   String
  company      Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id      String
  user         User      @relation("UserPosShifts", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  start_time    DateTime  @default(now())
  end_time      DateTime?
  starting_cash Float
  ending_cash   Float?
  status        String // OPEN, CLOSED

  sales SalesOrder[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model AiChatHistory {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id    String
  user       User    @relation("UserAiChats", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prompt     String
  response   String
  module     String?

  created_at DateTime @default(now())
}

// =======================
// HR & PAYROLL (PHASE 4)
// =======================

model Department {
  id          String  @id @default(uuid())
  company_id  String
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  description String?

  employees Employee[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, name])
}

model Employee {
  sawmillProductionRuns SawmillProductionRun[]
  id                    String                 @id @default(uuid())
  company_id            String
  company               Company                @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id          String?
  warehouse             Warehouse?             @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department_id         String?
  department            Department?            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  employee_code String
  first_name    String
  last_name     String?
  email         String?
  phone         String?
  position      String?
  join_date     DateTime?
  status        String // ACTIVE, RESIGNED, TERMINATED

  basic_salary   Float   @default(0)
  bank_name      String?
  default_shift_id String?
  account_number String?

  fingerprint_right_thumb String?
  fingerprint_left_thumb  String?

  attendances Attendance[]
  payrolls    Payroll[]

  expense_claims ExpenseClaim[]
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  LeaveRequest   LeaveRequest[]
  shift          Shift? @relation(fields: [default_shift_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, employee_code])
}

model Attendance {
  id          String    @id @default(uuid())
  company_id  String?
  employee_id String
  employee    Employee  @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  status      String // PRESENT, ABSENT, LEAVE, SICK, LATE
  check_in    DateTime?
  check_out   DateTime?
  notes       String?
  
  shift_id         String?
  shift            Shift?  @relation(fields: [shift_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  late_minutes     Int     @default(0)
  overtime_minutes Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Payroll {
  company_id  String?
  company     Company? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String   @id @default(uuid())
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period      String // e.g. "2026-07"

  basic_salary    Float @default(0)
  total_allowance Float @default(0)
  total_deduction Float @default(0)
  net_salary      Float @default(0)

  status    String // DRAFT, APPROVED, PAID
  paid_date DateTime?

  items PayrollItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model PayrollItem {
  id         String  @id @default(uuid())
  payroll_id String
  payroll    Payroll @relation(fields: [payroll_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type       String // ALLOWANCE, DEDUCTION
  name       String
  amount     Float

  created_at DateTime @default(now())
}

model MarketplaceIntegration {
  id            String    @id @default(uuid())
  company_id    String
  company       Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platform      String // e.g., 'SHOPEE', 'TOKOPEDIA'
  partner_id    String?
  partner_key   String?
  shop_id       String?
  access_token  String?
  refresh_token String?
  token_expiry  DateTime?
  status        String    @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, platform])
}

// =======================
// B2B SALES (PHASE 3)
// =======================

model Quotation {
  id               String    @id @default(uuid())
  company_id       String
  company          Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id      String
  customer         Customer  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotation_number String
  quotation_date   DateTime
  expiration_date  DateTime?
  status           String // DRAFT, SENT, CONFIRMED, CANCELLED
  total_amount     Float
  notes            String?
  billing_address  String?
  delivery_address String?
  payment_terms    String?

  items        QuotationItem[]
  sales_orders SalesOrder[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, quotation_number])
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotation_id String
  quotation    Quotation @relation(fields: [quotation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id   String
  product      Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty          Float
  unit_price   Float
  discount     Float     @default(0)
  tax          Float     @default(0)
  subtotal     Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model DeliveryOrder {
  idempotency_key  String?
  id               String     @id @default(uuid())
  company_id       String
  company          Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_order_id   String
  sales_order      SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_number  String
  delivery_date    DateTime
  status           String // WAITING, READY, DELIVERED, CANCELLED
  driver_name      String?
  vehicle_plate    String?
  container_number String?
  notes            String?

  items DeliveryOrderItem[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, idempotency_key])
  @@unique([company_id, delivery_number])
}

model DeliveryOrderItem {
  id                String        @id @default(uuid())
  delivery_order_id String
  delivery_order    DeliveryOrder @relation(fields: [delivery_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id        String
  product           Product       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordered_qty       Float
  delivered_qty     Float
  remaining_qty     Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Invoice {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type       String  @default("AR") // "AR" (Accounts Receivable) or "AP" (Accounts Payable)

  sales_order_id String?
  sales_order    SalesOrder? @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id    String?
  customer       Customer?   @relation("InvoiceCustomer", fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  purchase_order_id String?
  purchase_order    PurchaseOrder? @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id       String?
  supplier          Customer?      @relation("InvoiceSupplier", fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  invoice_number String
  invoice_date   DateTime
  due_date       DateTime?
  status         String // DRAFT, POSTED, PARTIALLY PAID, PAID, CANCELLED

  subtotal         Float
  tax              Float
  total            Float
  paid_amount      Float @default(0)
  remaining_amount Float

  items    InvoiceItem[]
  payments Payment[]

  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  deleted_at        DateTime?
  PaymentAllocation PaymentAllocation[]
  NettingAllocation NettingAllocation[]

  @@unique([company_id, invoice_number])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoice_id  String
  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id  String
  product     Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String?
  qty         Float
  unit_price  Float
  discount    Float   @default(0)
  tax         Float   @default(0)
  subtotal    Float
}

model Payment {
  id             String    @id @default(uuid())
  company_id     String
  company        Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_id     String?
  invoice        Invoice?  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_number String
  payment_date   DateTime
  amount         Float
  payment_method String // CASH, BANK_TRANSFER, etc.
  reference      String?
  notes          String?

  created_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  allocations PaymentAllocation[]

  @@unique([company_id, payment_number])
}

model PaymentAllocation {
  id             String      @id @default(uuid())
  payment_id     String
  payment        Payment     @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  sales_order_id String?
  sales_order    SalesOrder? @relation(fields: [sales_order_id], references: [id], onDelete: NoAction)
  invoice_id     String?
  invoice        Invoice?    @relation(fields: [invoice_id], references: [id], onDelete: NoAction)
  amount         Float

  created_at DateTime @default(now())
}

model PurchaseOrder {
  id               String           @id @default(uuid())
  company_id       String
  company          Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id      String
  supplier         Customer         @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_number     String
  order_date       DateTime
  expected_receipt DateTime?
  status           String // DRAFT, CONFIRMED, CANCELLED
  purchaseReturns  PurchaseReturn[]
  receipt_status   String           @default("PENDING") // PENDING, PARTIAL, RECEIVED
  bill_status      String           @default("PENDING") // PENDING, BILLED
  payment_status   String           @default("UNPAID") // UNPAID, PARTIAL, PAID

  warehouse_id String?
  warehouse    Warehouse? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  total_amount  Float
  notes         String?
  payment_terms String?

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]
  invoices Invoice[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, order_number])
}

model PurchaseOrderItem {
  id                String               @id @default(uuid())
  purchase_order_id String
  purchase_order    PurchaseOrder        @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id        String
  product           Product              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty               Float
  received_qty      Float                @default(0)
  billed_qty        Float                @default(0)
  returned_qty      Float                @default(0)
  purchaseReturns   PurchaseReturnItem[]
  unit_price        Float
  discount          Float                @default(0)
  tax               Float                @default(0)
  subtotal          Float
}

model GoodsReceipt {
  id                String        @id @default(uuid())
  company_id        String
  company           Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id       String
  supplier          Customer      @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id      String
  warehouse         Warehouse     @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt_number    String
  receipt_date      DateTime
  status            String // DRAFT, VALIDATED

  items GoodsReceiptItem[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, receipt_number])
}

model GoodsReceiptItem {
  id               String       @id @default(uuid())
  goods_receipt_id String
  goods_receipt    GoodsReceipt @relation(fields: [goods_receipt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id       String
  product          Product      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty              Float
}

model LeaveRequest {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  leave_type String
  start_date DateTime
  end_date   DateTime
  reason     String?
  status     String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED

  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @updatedAt
  CompanySetting             CompanySetting?           @relation(fields: [companySettingId], references: [id])
  companySettingId           String?
  Permission                 Permission?               @relation(fields: [permissionId], references: [id])
  permissionId               String?
  ProductImage               ProductImage?             @relation(fields: [productImageId], references: [id])
  productImageId             String?
  ProductDocument            ProductDocument?          @relation(fields: [productDocumentId], references: [id])
  productDocumentId          String?
  AssetBorrowing             AssetBorrowing?           @relation(fields: [assetBorrowingId], references: [id])
  assetBorrowingId           String?
  MaintenanceLog             MaintenanceLog?           @relation(fields: [maintenanceLogId], references: [id])
  maintenanceLogId           String?
  MaintenanceSchedule        MaintenanceSchedule?      @relation(fields: [maintenanceScheduleId], references: [id])
  maintenanceScheduleId      String?
  WorkOrder                  WorkOrder?                @relation(fields: [workOrderId], references: [id])
  workOrderId                String?
  InventoryTransactionItem   InventoryTransactionItem? @relation(fields: [inventoryTransactionItemId], references: [id])
  inventoryTransactionItemId String?
  PettyCash                  PettyCash?                @relation(fields: [pettyCashId], references: [id])
  pettyCashId                String?
  Budget                     Budget?                   @relation(fields: [budgetId], references: [id])
  budgetId                   String?
  Reconciliation             Reconciliation?           @relation(fields: [reconciliationId], references: [id])
  reconciliationId           String?
