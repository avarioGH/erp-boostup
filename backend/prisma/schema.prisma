  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reservedPcs Int   @default(0)
  reservedM3  Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([company_id, locationId, timberVariantId])
}

model TimberStock {
  id              String        @id @default(uuid())
  locationId      String
  location        Warehouse     @relation(fields: [locationId], references: [id])
  subLocationId   String?
  subLocation     Location?     @relation(fields: [subLocationId], references: [id])
  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  openingPcs      Int   @default(0)
  stockInPcs      Int   @default(0)
  stockOutPcs     Int   @default(0)
  adjustmentPcs   Int   @default(0)
  currentPcs      Int   @default(0)
  currentVolumeM3 Float @default(0)

  movements TimberStockMovement[]

  updatedAt DateTime @updatedAt

  batch            String                   @default("UNKNOWN")
  productionInputs ProductionProcessInput[]

  @@unique([locationId, timberVariantId, batch])
}

model TimberStockMovement {
  id            String      @id @default(uuid())
  timberStockId String
  timberStock   TimberStock @relation(fields: [timberStockId], references: [id])

  type          String // IN, OUT, ADJ
  referenceType String // PRODUCTION_OUTPUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_IN, ADJUSTMENT_OUT, etc.
  referenceId   String // e.g. SawnTimberOutput.id

  batch String @default("UNKNOWN")

  quantityPcs Int
  volumeM3    Float

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([timberStockId, date])
  @@index([referenceType, referenceId])
}

// ==================================================
// PHASE 6: LEDGER, TRANSFERS & ADJUSTMENTS
// ==================================================

model StockTransfer {
  id             String    @id @default(uuid())
  transferNumber String    @unique
  transferDate   DateTime  @default(now())
  fromLocationId String
  fromLocation   Warehouse @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Warehouse @relation("TransferToLocation", fields: [toLocationId], references: [id])
  status         String    @default("DRAFT") // DRAFT, POSTED, CANCELLED
  notes          String?

  items StockTransferItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  batch String @default("UNKNOWN")

  quantityPcs Int
  volumeM3    Float
  notes       String?
}

model StockAdjustment {
  id               String    @id @default(uuid())
  adjustmentNumber String    @unique
  adjustmentDate   DateTime  @default(now())
  locationId       String
  location         Warehouse @relation(fields: [locationId], references: [id])
  status           String    @default("DRAFT") // DRAFT, POSTED, CANCELLED
  reason           String?
  notes            String?

  items StockAdjustmentItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockAdjustmentItem {
  id           String          @id @default(uuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  batch String @default("UNKNOWN")

  systemPcs     Int
  physicalPcs   Int
  differencePcs Int
  differenceM3  Float
  notes         String?
}

// ==================================================
// PHASE 7: IMPORT SESSION
// ==================================================

model ImportSession {
  id            String  @id @default(uuid())
  fileName      String
  fileType      String?
  importType    String // RAW_LOG, TRIMMING_LOG, INPUT_LOG, SAWN_TIMBER_OUTPUT, STOCK_OPENING_BALANCE
  status        String  @default("UPLOADED") // UPLOADED, VALIDATING, READY, IMPORTING, COMPLETED, COMPLETED_WITH_ERRORS, FAILED, CANCELLED
  selectedSheet String?

  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  duplicateRows Int @default(0)
  importedRows  Int @default(0)
  skippedRows   Int @default(0)

  errorSummary String?

  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// ==========================================
// PHASE 13: TIMBER SALES & ORDER REALIZATION
// ==========================================
// Separate from the existing generic SalesOrder (POS/B2B).
// Timber Sales operates on TimberVariant-dimensional items.

model TimberSalesOrder {
  id              String    @id @default(uuid())
  orderNumber     String    @unique
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  orderDate       DateTime
  targetDate      DateTime?
  partai          String? // Optional partai requirement from customer
  notes           String?
  // DRAFT -> CONFIRMED -> PARTIALLY_FULFILLED -> FULFILLED -> CANCELLED
  status          String    @default("DRAFT")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items      TimberSalesOrderItem[]
  deliveries TimberDeliveryNote[]
  shipments  TimberShipment[]
}

model TimberSalesOrderItem {
  id           String           @id @default(uuid())
  salesOrderId String
  salesOrder   TimberSalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  // Dimensional identity - references TimberVariant
  timberVariantId String?
  timberVariant   TimberVariant? @relation(fields: [timberVariantId], references: [id])

  // Explicitly stored for historical accuracy even if variant changes
  thicknessMm           Int
  widthMm               Int
  lengthMm              Int
  fulfillmentLocationId String?
  fulfillmentLocation   Warehouse? @relation(fields: [fulfillmentLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grade                 String?
  species               String?

  orderQty Int // PCS
  orderM3  Float // Pre-calculated

  // Realization cache (updated when delivery items are posted)
  realizedQty Int   @default(0)
  realizedM3  Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryItems       TimberDeliveryNoteItem[]
  timberShipmentItems TimberShipmentItem[]
}

model TimberDeliveryNote {
  id             String           @id @default(uuid())
  deliveryNumber String           @unique
  salesOrderId   String
  salesOrder     TimberSalesOrder @relation(fields: [salesOrderId], references: [id])
  deliveryDate   DateTime
  driverName     String?
  vehicleNumber  String?
  notes          String?
  // DRAFT -> POSTED -> CANCELLED
  status         String           @default("DRAFT")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items TimberDeliveryNoteItem[]
}

model TimberDeliveryNoteItem {
  id             String             @id @default(uuid())
  deliveryNoteId String
  deliveryNote   TimberDeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  salesOrderItemId String
  salesOrderItem   TimberSalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  // Source stock identity
  locationId      String
  location        Warehouse     @relation(fields: [locationId], references: [id])
  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  deliveredQty Int
  deliveredM3  Float

  // Linked stock movement (created by InventoryLedgerService on Post)
  stockMovementId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SawmillBundle {
  id             String              @id @default(uuid())
  bundleNumber   String              @unique
  parentBundleId String?
  parentBundle   SawmillBundle?      @relation("RepackedFrom", fields: [parentBundleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childBundles   SawmillBundle[]     @relation("RepackedFrom")
  status         String              @default("ACTIVE") // ACTIVE, REPACKED, SHIPPED
  outputItems    SawmillOutputItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model SawmillProductionRun {
  id             String                         @id @default(uuid())
  productionNo   String                         @unique
  productionDate DateTime
  shift          String
  operatorId     String
  operator       Employee                       @relation(fields: [operatorId], references: [id])
  workCenterId   String
  workCenter     WorkCenter                     @relation(fields: [workCenterId], references: [id])
  status         String                         @default("DRAFT") // DRAFT, POSTED, CANCELLED
  notes          String?
  consumptions   SawmillProductionConsumption[]
  outputItems    SawmillOutputItem[]
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
}

model SawmillProductionConsumption {
  id              String               @id @default(uuid())
  inputLogId      String
  inputLog        InputLog             @relation(fields: [inputLogId], references: [id])
  productionRunId String
  productionRun   SawmillProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  consumedM3      Float
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model SawmillOutputItem {
  id                 String               @id @default(uuid())
  productionRunId    String
  productionRun      SawmillProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  bundleId           String
  bundle             SawmillBundle        @relation(fields: [bundleId], references: [id])
  timberVariantId    String
  timberVariant      TimberVariant        @relation(fields: [timberVariantId], references: [id])
  partai             String
  quantityPcs        Int
  volumeM3           Float
  remarks            String?
  stockMovementId    String? // Ledger IN
  reversalMovementId String? // Ledger OUT (if cancelled)
}

// =======================
// TIMBER MASTER DATA (PHASE 16)
// =======================

model TimberSpecies {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rawLogs                RawLog[]
  trimmedLogs            TrimmedLog[]
  inputLogs              InputLog[]
  variants               TimberVariant[]
  timberPurchaseLogItems TimberPurchaseLogItem[]
}

model TimberGrade {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants TimberVariant[]
}

model TimberSource {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  type        String // SUPPLIER, EXTERNAL, INTERNAL, OTHER
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rawLogs         RawLog[]
  trimmedLogs     TrimmedLog[]
  inputLogs       InputLog[]
  timberPurchases TimberPurchase[]
}

model Location {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timberStocks TimberStock[]
}

model Vehicle {
  id              String           @id @default(uuid())
  company_id      String
  company         Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code            String
  plateNumber     String
  name            String?
  vehicleType     String // TRUCK, FUSO, PICKUP, OTHER
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  timberShipments TimberShipment[]
}

model Driver {
  id              String           @id @default(uuid())
  company_id      String
  company         Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code            String?
  name            String
  phone           String?
  licenseNumber   String?
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  timberShipments TimberShipment[]
}

// ==================================================
// PHASE 18: TIMBER PRODUCTION PROCESS ENGINE
// ==================================================

model ProductionProcess {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processNo   String   @unique
  processType String // GESEK, PLAT, MASAK, etc.
  processDate DateTime @default(now())
  status      String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  notes       String?
  createdBy   String?

  partaiId String?
  partai   TimberPartai? @relation(fields: [partaiId], references: [id])

  inputVolumeM3   Float @default(0)
  outputVolumeM3  Float @default(0)
  wasteVolumeM3   Float @default(0)
  yieldPercentage Float @default(0)

  inputs  ProductionProcessInput[]
  outputs ProductionProcessOutput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([company_id])
  @@index([partaiId])
}

model ProductionProcessInput {
  id                  String            @id @default(uuid())
  productionProcessId String
  productionProcess   ProductionProcess @relation(fields: [productionProcessId], references: [id], onDelete: Cascade)

  timberStockId String
  timberStock   TimberStock   @relation(fields: [timberStockId], references: [id])
  variantId     String
  variant       TimberVariant @relation(fields: [variantId], references: [id])

  quantityPCS Int
  volumeM3    Float
}

model ProductionProcessOutput {
  id                  String            @id @default(uuid())
  productionProcessId String
  productionProcess   ProductionProcess @relation(fields: [productionProcessId], references: [id], onDelete: Cascade)

  variantId String?
  variant   TimberVariant? @relation(fields: [variantId], references: [id]) // Optional because WASTE might not have a variant

  outputType  String // PRODUCT, WASTE, BYPRODUCT
  quantityPCS Int    @default(0)
  volumeM3    Float

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id]) // Target warehouse for this output
}

// ==================================================
// PHASE 20: TIMBER PURCHASE & SHIPMENT
// ==================================================

model TimberPurchase {
  partaiId       String?
  partai         TimberPartai? @relation(fields: [partaiId], references: [id])
  id             String        @id @default(uuid())
  company_id     String
  company        Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseNumber String        @unique
  purchaseDate   DateTime      @default(now())

  sourceId String
  source   TimberSource @relation(fields: [sourceId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status        String    @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  receivingDate DateTime?
  totalPcs      Int       @default(0)
  totalVolumeM3 Float   @default(0)
  notes         String?
  createdBy     String?

  items    TimberPurchaseItem[]
  logItems TimberPurchaseLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimberPurchaseItem {
  id               String         @id @default(uuid())
  timberPurchaseId String
  timberPurchase   TimberPurchase @relation(fields: [timberPurchaseId], references: [id], onDelete: Cascade)

  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  quantityPcs Int
  volumeM3    Float

  purchaseThickness Float?
  purchaseWidth     Float?
  purchaseLength    Float?
  unitPrice         Float?
  batch             String?
  notes             String?
}

model TimberPurchaseLogItem {
  id               String         @id @default(uuid())
  timberPurchaseId String
  timberPurchase   TimberPurchase @relation(fields: [timberPurchaseId], references: [id], onDelete: Cascade)

  logNumber     String
  species       String
  speciesId     String?
  timberSpecies TimberSpecies? @relation(fields: [speciesId], references: [id])

  purchaseLength    Float
  purchaseDiameter1 Float
  purchaseDiameter2 Float
  purchaseDiameter3 Float
  purchaseDiameter4 Float
  purchaseVolume    Float

  status        String    @default("EXPECTED") // EXPECTED, RECEIVED
  receivingDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?
}

model TimberShipment {
  id             String   @id @default(uuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipmentNumber String   @unique
  shipmentDate   DateTime @default(now())

  warehouseId String
  warehouse   Warehouse @relation("ShipmentOriginWarehouse", fields: [warehouseId], references: [id])

  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("ShipmentDestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  // Direct armada fields for external transport (Ex Kalteng Fuso / Truk)
  fusoName     String?
  policeNumber String?
  driverName   String?

  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  destinationName    String?
  destinationAddress String?

  salesOrderId String?
  salesOrder   TimberSalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  partaiId String?
  partai   TimberPartai? @relation(fields: [partaiId], references: [id])

  status        String  @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  totalPcs      Int     @default(0)
  totalVolumeM3 Float   @default(0)
  notes         String?
  createdBy     String?

  items TimberShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([company_id])
  @@index([partaiId])
}

model TimberShipmentItem {
  id               String         @id @default(uuid())
  timberShipmentId String
  timberShipment   TimberShipment @relation(fields: [timberShipmentId], references: [id], onDelete: Cascade)

  timberVariantId String?
  timberVariant   TimberVariant? @relation(fields: [timberVariantId], references: [id])

  batch String @default("UNKNOWN")

  // Dimension & classification fields for direct tally muat
  species         String?
  productCategory String? @default("BALOK") // BALOK, RENG, AFKIR_BS, AIR_DRY, etc.
  thicknessMm     Float?
  widthMm         Float?
  lengthMm        Float?

  quantityPcs      Int
  volumeM3         Float
  salesOrderItemId String?
  salesOrderItem   TimberSalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
}

// ==================================================
// PHASE 21: TIMBER STOCK OPNAME
// ==================================================

model TimberStockOpname {
  id           String   @id @default(uuid())
  company_id   String
  company      Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opnameNumber String   @unique
  opnameDate   DateTime @default(now())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status      String    @default("DRAFT") // DRAFT, COUNTING, CONFIRMED, CANCELLED
  notes       String?
  createdBy   String?
  confirmedBy String?
  confirmedAt DateTime?

  items TimberStockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimberStockOpnameItem {
  id            String            @id @default(uuid())
  stockOpnameId String
  stockOpname   TimberStockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)

  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  batch String @default("UNKNOWN")

  systemQuantityPcs Int
  systemVolumeM3    Float

  physicalQuantityPcs Int
  physicalVolumeM3    Float

  varianceQuantityPcs Int
  varianceVolumeM3    Float

  notes String?
}

// ==================================================
// PHASE 22: ZERO-DELTA TIMBER BATCH RECLASSIFICATION
// ==================================================

model TimberBatchReclassification {
  id              String   @id @default(uuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reclassNumber   String   @unique
  idempotencyKey  String   // Wajib non-null untuk mencegah duplicate null collision di MongoDB
  date            DateTime @default(now())

  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  timberVariantId String
  timberVariant   TimberVariant @relation(fields: [timberVariantId], references: [id])

  sourceBatch     String   @default("UNKNOWN")
  targetBatch     String   // Verified Partai code

  quantityPcs     Int
  volumeM3        Float

  status          String   @default("POSTED") // POSTED, REVERSED
  reason          String
  evidenceType    String   // PHYSICAL_OPNAME_APPROVED, PHYSICAL_TALLY_AUDITED, DELIVERY_DOC
  evidenceRef     String?

  createdBy       String
  approvedBy      String?

  reversedAt      DateTime?
  reversedBy      String?
  reversalReason  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([company_id, idempotencyKey])
  @@index([company_id, warehouseId, timberVariantId])
  @@index([company_id, status])
  @@index([company_id, targetBatch])
}

// ==================================================
// EXPORT PACKING LIST (FISH & GENERAL)
// ==================================================

model ExportShipment {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  containerNo String
  sealNo      String
  vehicleNo   String
  exportDate  DateTime
  status      String   @default("DRAFT")

  items ExportShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExportShipmentItem {
  id       String         @id @default(uuid())
  exportId String
  export   ExportShipment @relation(fields: [exportId], references: [id], onDelete: Cascade)

  groupName   String // Supplier / Customer grouping (e.g. "PAK LUCKY")
  productName String
  qtyKg       Float
  qtyMc       Int
  qtySak      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockInTally {
  idempotency_key String?
  status          String             @default("POSTED")
  id              String             @id @default(uuid())
  company_id      String
  company         Company            @relation(fields: [company_id], references: [id])
  tally_number    String
  tally_date      DateTime           @default(now())
  warehouse_id    String
  warehouse       Warehouse          @relation(fields: [warehouse_id], references: [id])
  notes           String?
  items           StockInTallyItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, idempotency_key])
}

model StockInTallyItem {
  id          String       @id @default(uuid())
  tally_id    String
  tally       StockInTally @relation(fields: [tally_id], references: [id], onDelete: Cascade)
  product_id  String
  product     Product      @relation(fields: [product_id], references: [id])
  qty         Float
  movement_id String?
}

// ==================================================
// TIMBER PARTAI (PROJECT / BATCH)
// ==================================================
model TimberPartai {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  code   String
  name   String?
  status String  @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED

  startDate DateTime  @default(now())
  endDate   DateTime?

  notes     String?
  createdBy String?

  purchases   TimberPurchase[]
  rawLogs     RawLog[]
  trimmedLogs TrimmedLog[]
  inputLogs   InputLog[]
  sawnOutputs SawnTimberOutput[]
  productionProcesses ProductionProcess[]
  shipments   TimberShipment[]
  packings    TimberPacking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([company_id, code])
  @@index([company_id])
}

// ==================================================
// TIMBER PACKING LIST (DUAL RECORD: ASLI VS CUSTOMER)
// Sesuai Sheet PACKING di Excel 6
// ==================================================
model TimberPacking {
  id         String        @id @default(uuid())
  company_id String
  company    Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partaiId   String?
  partai     TimberPartai? @relation(fields: [partaiId], references: [id])

  packingNumber String   @unique // Contoh: PKG-2026-001
  packingDate   DateTime @default(now())
  ownerName     String?  // Contoh: PT Daun Emas Multi Perkasa
  species       String?  // Contoh: MERBAU
  containerNo   String?  // No Kontainer jika ada
  palletCount   Int      @default(0)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  status String @default("CONFIRMED") // DRAFT, CONFIRMED, CANCELLED
  notes  String?

  totalRealPcs     Int   @default(0)
  totalRealVolume  Float @default(0)
  totalCustPcs     Int   @default(0)
  totalCustVolume  Float @default(0)

  items TimberPackingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([company_id])
  @@index([partaiId])
}

model TimberPackingItem {
  id        String        @id @default(uuid())
  packingId String
  packing   TimberPacking @relation(fields: [packingId], references: [id], onDelete: Cascade)

  palletNo String? // Contoh: "01", "02"

  // 1. Data Ukuran Asli Pabrik
  realT Float // cm
  realL Float // cm
  realP Float // cm
  realPcs Int
  realM3 Float

  // 2. Data Ukuran Customer / Perjanjian Nominal
  custT Float? // cm
  custL Float? // cm
  custP Float? // cm
  custPcs Int?
  custM3 Float?

  notes String? // Keterangan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryDisposal {
  id           String    @id @default(uuid())
  company_id   String
  company      Company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  disposal_number String
  disposal_date   DateTime
  status          String // DRAFT, PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  reason          String
  notes           String?

  created_by  String?
  creator     User?   @relation("DisposalCreator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by String?
  approver    User?   @relation("DisposalApprover", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approved_at  DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  items InventoryDisposalItem[]

  @@unique([company_id, disposal_number])
}

model InventoryDisposalItem {
  id          String            @id @default(uuid())
  disposal_id String
  disposal    InventoryDisposal @relation(fields: [disposal_id], references: [id], onDelete: Cascade)
  product_id  String
  product     Product           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  qty   Float
  unit  String?
  notes String?
}

model StockTransformation {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transform_no String   @unique
  date         DateTime @default(now())
  status       String   @default("COMPLETED") // DRAFT, COMPLETED, CANCELLED
  notes        String?
  created_by   String
  user         User     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  inputs  StockTransformationInput[]
  outputs StockTransformationOutput[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model StockTransformationInput {
  id                String              @id @default(uuid())
  transformation_id String
  transformation    StockTransformation @relation(fields: [transformation_id], references: [id], onDelete: Cascade)

  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  qty        Float
  unit_cost  Float @default(0)
  total_cost Float @default(0)
}

model StockTransformationOutput {
  id                String              @id @default(uuid())
  transformation_id String
  transformation    StockTransformation @relation(fields: [transformation_id], references: [id], onDelete: Cascade)

  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  qty        Float
  unit_cost  Float @default(0)
  total_cost Float @default(0)
}

model PurchaseReturn {
  id                String        @id @default(uuid())
  company_id        String
  company           Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  return_number     String
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id       String
  supplier          Customer      @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id      String
  warehouse         Warehouse     @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  return_date  DateTime
  status       String // DRAFT, PROCESSING, POSTED, REVERSED
  reason       String
  notes        String?
  total_amount Float    @default(0) // Informational: based on returned FIFO value or purchase value

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items PurchaseReturnItem[]

  @@unique([company_id, return_number])
}

model PurchaseReturnItem {
  id                     String            @id @default(uuid())
  purchase_return_id     String
  purchase_return        PurchaseReturn    @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  purchase_order_item_id String
  purchase_order_item    PurchaseOrderItem @relation(fields: [purchase_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id             String
  product                Product           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  quantity   Float
  unit       String?
  unit_cost  Float   @default(0)
  total_cost Float   @default(0)
  reason     String?
}

model SalesReturn {
  id             String     @id @default(uuid())
  company_id     String
  company        Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  return_number  String
  sales_order_id String
  sales_order    SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id    String
  customer       Customer   @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id   String
  warehouse      Warehouse  @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  return_date     DateTime
  status          String // DRAFT, PROCESSING, POSTED, REVERSED
  reason          String
  notes           String?
  total_amount    Float    @default(0) // Total Revenue Reversal Amount
  idempotency_key String?

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items                     SalesReturnItem[]
  SalesReturnCostAllocation SalesReturnCostAllocation[]

  @@unique([company_id, return_number])
}

model SalesReturnItem {
  id                  String         @id @default(uuid())
  sales_return_id     String
  sales_return        SalesReturn    @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  sales_order_item_id String
  sales_order_item    SalesOrderItem @relation(fields: [sales_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id          String
  product             Product        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  quantity          Float
  unit              String?
  unit_price        Float   @default(0)
  total_sales_value Float   @default(0)
  unit_cost         Float   @default(0) // Authoritative from historical CostLayerConsumption
  total_cost        Float   @default(0)
  reason            String?

  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  SalesReturnCostAllocation SalesReturnCostAllocation[]
}

model SalesReturnCostAllocation {
  id                   String          @id @default(uuid())
  company_id           String
  sales_return_id      String
  sales_return         SalesReturn     @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  sales_return_item_id String
  sales_return_item    SalesReturnItem @relation(fields: [sales_return_item_id], references: [id], onDelete: Cascade)

  original_cost_layer_id             String
  original_cost_layer_consumption_id String

  restored_cost_layer_id String? // Points to InventoryCostLayer created by receiveStock

  quantity     Float
  unit_cost    Float
  total_cost   Float
  warehouse_id String

  created_at DateTime @default(now())

  @@index([sales_return_id])
}


model Shift {
  id                   String    @id @default(uuid())
  company_id           String?
  company              Company?  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                 String
  name                 String
  start_time           String    // e.g. "08:00"
  end_time             String    // e.g. "17:00"
  grace_period_minutes Int       @default(15) // Minutes before marked LATE
  status               String    @default("ACTIVE")
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  employees            Employee[]
  attendances          Attendance[]

  @@unique([company_id, code])
}
