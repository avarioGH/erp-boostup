  sourceId        String?
  timberSource    TimberSource?  @relation(fields: [sourceId], references: [id])
  length          Float
  diameter1       Float
  diameter2       Float
  diameter3       Float
  diameter4       Float
  averageDiameter Float
  roundedDiameter Float

