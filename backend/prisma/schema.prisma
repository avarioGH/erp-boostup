// TIMBER INVENTORY: RAW LOG
// --------------------------------------------------
model RawLog {
  partaiId          String?
  partai            TimberPartai?  @relation(fields: [partaiId], references: [id])
  purchaseLogItemId String?
  id                String         @id @default(uuid())
  logNumber         String // No Log
  sequence          Int? // Urut
  code              String? // Kode
  species           String // Jenis Kayu
  speciesId         String?
  timberSpecies     TimberSpecies? @relation(fields: [speciesId], references: [id])
  sourceId          String?
  timberSource      TimberSource?  @relation(fields: [sourceId], references: [id])
  quantity          Int            @default(1)
  originalLength    Float // Pjng (meters)

  diameter1       Float // D1 (cm)
  diameter2       Float // D2 (cm)
  diameter3       Float // D3 (cm)
  diameter4       Float // D4 (cm)
  averageDiameter Float // ????????
  roundedDiameter Float // ????????2

  grossVolume    Float // Brutto (m3)
  gerowong       Float? // Gerowong diameter (cm)
  hollowVolume   Float? // Vol Gerowong (m3)
  trimmingLength Float? // Trimming (m)
  trimmingVolume Float? // Vol Tr (m3)
  netVolume      Float // Netto (m3)

  barcode       String?
  diameterClass String?
  batch         String? // Partai
  supplierRef   String?
  receivingDate DateTime @default(now())

  locationId String?
  location   Warehouse? @relation(fields: [locationId], references: [id])
  status     String     @default("AVAILABLE") // AVAILABLE, RESERVED, IN_TRIMMING, TRIMMED, CONSUMED, CANCELLED

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trimmedLogs   TrimmedLog[]
  inputLogId    String?
  inputLog      InputLog?      @relation(fields: [inputLogId], references: [id])
  inputLogItems InputLogItem[]
  @@index([partaiId])
}

