  DashboardWidget            DashboardWidget?          @relation(fields: [dashboardWidgetId], references: [id])
  dashboardWidgetId          String?                   @db.ObjectId
  ReportSchedule             ReportSchedule?           @relation(fields: [reportScheduleId], references: [id])
  reportScheduleId           String?                   @db.ObjectId
  WorkflowMaster             WorkflowMaster?           @relation(fields: [workflowMasterId], references: [id])
  workflowMasterId           String?                   @db.ObjectId
  ApprovalRequest            ApprovalRequest?          @relation(fields: [approvalRequestId], references: [id])
  approvalRequestId          String?                   @db.ObjectId
  UserTask                   UserTask?                 @relation(fields: [userTaskId], references: [id])
  userTaskId                 String?                   @db.ObjectId
  Tenant                     Tenant?                   @relation(fields: [tenantId], references: [id])
  tenantId                   String?                   @db.ObjectId
  SubscriptionPlan           SubscriptionPlan?         @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanId         String?                   @db.ObjectId
  TenantSubscription         TenantSubscription?       @relation(fields: [tenantSubscriptionId], references: [id])
  tenantSubscriptionId       String?                   @db.ObjectId
  SalesOrderItem             SalesOrderItem?           @relation(fields: [salesOrderItemId], references: [id])
  salesOrderItemId           String?                   @db.ObjectId
  PosShift                   PosShift?                 @relation(fields: [posShiftId], references: [id])
  posShiftId                 String?                   @db.ObjectId
  Attendance                 Attendance?               @relation(fields: [attendanceId], references: [id])
  attendanceId               String?                   @db.ObjectId
  Payroll                    Payroll?                  @relation(fields: [payrollId], references: [id])
  payrollId                  String?                   @db.ObjectId
  QuotationItem              QuotationItem?            @relation(fields: [quotationItemId], references: [id])
  quotationItemId            String?                   @db.ObjectId
  DeliveryOrderItem          DeliveryOrderItem?        @relation(fields: [deliveryOrderItemId], references: [id])
  deliveryOrderItemId        String?                   @db.ObjectId
}

model Lead {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  lead_code      String
  name           String
  company_name   String?
  email          String?
  phone          String?
  source         String // WEBSITE, WHATSAPP, REFERRAL, SOCIAL_MEDIA, EVENT, MANUAL, OTHER
  assigned_user  String? // Could be User ID, keeping it string for simplicity
  status         String // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, LOST
  expected_value Float   @default(0)
  notes          String?

  opportunities Opportunity[]
  activities    CrmActivity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Opportunity {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title       String
  customer_id String?   @db.ObjectId
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead_id     String?   @db.ObjectId
  lead        Lead?     @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  expected_value      Float     @default(0)
  probability         Float     @default(0) // 0-100
  expected_close_date DateTime?
  assigned_user       String?
  stage               String // NEW, QUALIFICATION, PROPOSITION, NEGOTIATION, WON, LOST
  notes               String?

  activities CrmActivity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model CrmActivity {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assigned_user  String?
  lead_id        String?      @db.ObjectId
  lead           Lead?        @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity_id String?      @db.ObjectId
  opportunity    Opportunity? @relation(fields: [opportunity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_id    String?      @db.ObjectId
  customer       Customer?    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type         String // CALL, EMAIL, MEETING, FOLLOW_UP, NOTE, TASK
  title        String
  description  String?
  due_date     DateTime?
  status       String // TODO, IN_PROGRESS, DONE, CANCELLED
  completed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model DocumentSequence {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  company_id String @db.ObjectId
  type       String // 'INVOICE', 'QUOTATION', 'SALES_ORDER', 'PURCHASE_ORDER', 'VENDOR_BILL', 'PAYMENT'
  prefix     String // 'INV/2026/'
  last_value Int    @default(0)

  @@unique([company_id, type, prefix])
}
