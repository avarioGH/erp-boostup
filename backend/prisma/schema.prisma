generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  tenant_id  String? @db.ObjectId
  tenant     Tenant? @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String
  logo       String?
  address    String?
  phone      String?
  email      String?
  tax_number String?
  timezone   String  @default("Asia/Jakarta")
  currency   String  @default("IDR")

  // Relations
  settings        CompanySetting?
  roles           Role[]
  users           User[]
  warehouses      Warehouse[]
  suppliers       Supplier[]
  categories      Category[]
  units           Unit[]
  brands          Brand[]
  products        Product[]
  assetCategories AssetCategory[]
  assets          AssetMaster[]
  transactions    InventoryTransaction[]

  // Phase 5 Finance
  cash_accounts        CashAccount[]
  finance_categories   FinanceCategory[]
  finance_transactions FinanceTransaction[]
  petty_cashes         PettyCash[]
  budgets              Budget[]
  reconciliations      Reconciliation[]

  // Phase 6 Accounting
  account_types       AccountType[]
  chart_of_accounts   ChartOfAccount[]
  journal_entries     JournalEntry[]
  fiscal_years        FiscalYear[]
  accounting_periods  AccountingPeriod[]
  journal_adjustments JournalAdjustment[]
  journal_reversals   JournalReversal[]

  // Phase 7 BI
  dashboard_layouts DashboardLayout[]
  dashboard_widgets DashboardWidget[]
  business_insights BusinessInsight[]

  // Phase 8 Reporting & Document
  report_schedules   ReportSchedule[]
  report_export_logs ReportExportLog[]
  documents          DocumentMaster[]

  // Phase 9 Automation
  workflows         WorkflowMaster[]
  approval_requests ApprovalRequest[]
  inbox_messages    InternalInbox[]
  user_tasks        UserTask[]
  notif_templates   NotificationTemplate[]
  automation_logs   AutomationLog[]

  // Phase 2 CRM
  customers    Customer[]
  sales_orders SalesOrder[]
  vouchers     Voucher[]

  // Phase 4 HR
  departments Department[]
  employees   Employee[]

  // Phase 10 AI
  ai_chats                 AiChatHistory[]
  pos_shifts               PosShift[]
  marketplace_integrations MarketplaceIntegration[]

  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  deleted_at           DateTime?
  Quotation            Quotation[]
  DeliveryOrder        DeliveryOrder[]
  Invoice              Invoice[]
  Payment              Payment[]
  PurchaseOrder        PurchaseOrder[]
  GoodsReceipt         GoodsReceipt[]
  LeaveRequest         LeaveRequest[]
  Payroll              Payroll[]
  Lead                 Lead[]
  Opportunity          Opportunity[]
  CrmActivity          CrmActivity[]
  EcommerceCart        EcommerceCart[]
  InventoryCostLayer   InventoryCostLayer[]
  CostLayerConsumption CostLayerConsumption[]
}

model CompanySetting {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id           String  @unique @db.ObjectId
  company              Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency             String  @default("IDR")
  timezone             String  @default("Asia/Jakarta")
  language             String  @default("id")
  tax_percentage       Float   @default(11.0)
  logo                 String?
  invoice_prefix       String  @default("INV-")
  barcode_prefix       String  @default("BRC-")
  default_warehouse_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  company_id  String?  @db.ObjectId
  company     Company? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  description String?
  is_system   Boolean  @default(false)
  is_active   Boolean  @default(true)

  permissions RolePermission[]
  users       User[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, name])
}

model Permission {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?

  roles RolePermission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model RolePermission {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  role_id       String     @db.ObjectId
  role          Role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission_id String     @db.ObjectId
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())

  @@unique([role_id, permission_id])
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  company_id         String?   @db.ObjectId
  company            Company?  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role_id            String?   @db.ObjectId
  role               Role?     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  username           String    @unique
  name               String
  email              String?   @unique
  phone              String?
  password           String
  avatar             String?
  status             Boolean   @default(true)
  last_login         DateTime?
  accessible_modules String[]  @default([])

  created_transactions  InventoryTransaction[] @relation("CreatedTransactions")
  approved_transactions InventoryTransaction[] @relation("ApprovedTransactions")
  stock_movements       StockMovement[]

  // EAM Relations
  user_assets               AssetMaster[]     @relation("UserAssets")
  performed_asset_histories AssetHistory[]    @relation("PerformedAssetHistories")
  created_asset_locations   AssetLocation[]   @relation("CreatedAssetLocations")
  assigned_assets           AssetAssignment[] @relation("AssignedAssets")
  borrowed_assets           AssetBorrowing[]  @relation("BorrowedAssets")
  approved_asset_borrowings AssetBorrowing[]  @relation("ApprovedAssetBorrowings")
  created_maintenance_logs  MaintenanceLog[]  @relation("CreatedMaintenanceLogs")
  assigned_work_orders      WorkOrder[]       @relation("AssignedWorkOrders")
  created_work_orders       WorkOrder[]       @relation("CreatedWorkOrders")
  uploaded_asset_documents  AssetDocument[]   @relation("UploadedAssetDocuments")

  // Finance Relations
  created_finance_tx       FinanceTransaction[] @relation("CreatedFinanceTx")
  approved_finance_tx      FinanceTransaction[] @relation("ApprovedFinanceTx")
  uploaded_finance_docs    FinanceDocument[]    @relation("UploadedFinanceDocs")
  petty_cash_accounts      PettyCash[]          @relation("PettyCashEmployee")
  approved_reconciliations Reconciliation[]     @relation("ApprovedReconciliations")

  // Accounting Relations
  created_journals     JournalEntry[]      @relation("CreatedJournals")
  approved_journals    JournalEntry[]      @relation("ApprovedJournals")
  closed_fiscal_years  FiscalYear[]        @relation("ClosedFiscalYears")
  created_adjustments  JournalAdjustment[] @relation("CreatedAdjustments")
  approved_adjustments JournalAdjustment[] @relation("ApprovedAdjustments")
  created_reversals    JournalReversal[]   @relation("CreatedReversals")

  // BI Relations
  dashboard_layouts DashboardLayout[] @relation("DashboardLayouts")
  dashboard_widgets DashboardWidget[] @relation("DashboardWidgets")

  // Phase 8 Relations
  scheduled_reports      ReportSchedule[]    @relation("ScheduledReports")
  export_logs            ReportExportLog[]   @relation("ExportLogs")
  uploaded_documents     DocumentMaster[]    @relation("UploadedDocuments")
  uploaded_document_vers DocumentVersion[]   @relation("UploadedDocumentVersions")
  created_share_links    DocumentShareLink[] @relation("CreatedShareLinks")

  // Phase 9 Relations
  pending_approvals ApprovalRequest[] @relation("PendingApprovals")
  approval_history  ApprovalLog[]     @relation("ApprovalHistory")
  inbox_messages    InternalInbox[]   @relation("UserInbox")
  tasks             UserTask[]        @relation("UserTasks")
  // Phase 10 AI
  ai_chats          AiChatHistory[]   @relation("UserAiChats")

  // POS
  pos_shifts PosShift[] @relation("UserPosShifts")

  // RBAC Warehouse Access
  warehouse_accesses UserWarehouseAccess[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Warehouse {
  rawLogs               RawLog[]
  trimmedLogs           TrimmedLog[]
  inputLogs             InputLog[]
  manufacturing_orders  ManufacturingOrder[]
  material_reservations MaterialReservation[]
  timberDeliveryItems   TimberDeliveryNoteItem[]
  id                    String                   @id @default(auto()) @map("_id") @db.ObjectId
  company_id            String                   @db.ObjectId
  company               Company                  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                  String
  name                  String
  address               String?
  pic                   String?
  phone                 String?
  description           String?
  status                Boolean                  @default(true)

  transactions_as_origin InventoryTransaction[] @relation("TransactionWarehouse")
  transactions_as_target InventoryTransaction[] @relation("TransactionTargetWarehouse")
  stock_movements        StockMovement[]
  warehouse_stocks       WarehouseStock[]
  sawnOutputs            SawnTimberOutput[]
  timberStocks           TimberStock[]
  transfersFrom          StockTransfer[]        @relation("TransferFromLocation")
  transfersTo            StockTransfer[]        @relation("TransferToLocation")
  adjustments            StockAdjustment[]
  finance_transactions   FinanceTransaction[]
  customers              Customer[]
  employees              Employee[]
  pos_shifts             PosShift[]

  user_accesses UserWarehouseAccess[]

  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  PurchaseOrder      PurchaseOrder[]
  GoodsReceipt       GoodsReceipt[]
  InventoryCostLayer InventoryCostLayer[]

  @@unique([company_id, code])
}

model UserWarehouseAccess {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String    @db.ObjectId
  user         User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String    @db.ObjectId
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_at   DateTime  @default(now())

  @@unique([user_id, warehouse_id])
}

model Supplier {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code       String
  name       String
  phone      String?
  email      String?
  address    String?
  pic        String?
  tax_number String?
  notes      String?
  status     Boolean @default(true)

  products        Product[]
  purchase_orders PurchaseOrder[]
  invoices        Invoice[]
  goods_receipts  GoodsReceipt[]

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  deleted_at      DateTime?
  SupplierProduct SupplierProduct[]

  @@unique([company_id, code])
}

model Category {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  company_id String     @db.ObjectId
  company    Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?    @db.ObjectId
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[] @relation("CategoryHierarchy")
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Unit {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Brand {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String

  products Product[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Product {
  timberVariants            TimberVariant[]
  boms                      Bom[]
  bom_items                 BomItem[]
  manufacturing_orders      ManufacturingOrder[]
  manufacturing_order_items ManufacturingOrderItem[]
  quality_control_points    QualityControlPoint[]
  material_reservations     MaterialReservation[]
  id                        String                   @id @default(auto()) @map("_id") @db.ObjectId
  company_id                String                   @db.ObjectId
  company                   Company                  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id               String?                  @db.ObjectId
  category                  Category?                @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand_id                  String?                  @db.ObjectId
  brand                     Brand?                   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit_id                   String                   @db.ObjectId
  unit                      Unit                     @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_id               String?                  @db.ObjectId
  supplier                  Supplier?                @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  code           String
  barcode        String?
  name           String
  description    String?
  purchase_price Float
  selling_price  Float
  minimum_stock  Int     @default(0)
  weight         Float?
  length         Float?
  width          Float?
  height         Float?
  image          String?
  status         Boolean @default(true)

  // Ecommerce Fields
  is_published         Boolean @default(false)
  ecommerce_slug       String?
  seo_title            String?
  seo_description      String?
  ecommerce_sort_order Int     @default(0)

  images               ProductImage[]
  documents            ProductDocument[]
  transaction_items    InventoryTransactionItem[]
  stock_movements      StockMovement[]
  warehouse_stocks     WarehouseStock[]
  sales_order_items    SalesOrderItem[]
  ecommerce_cart_items EcommerceCartItem[]

  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  QuotationItem      QuotationItem[]
  DeliveryOrderItem  DeliveryOrderItem[]
  InvoiceItem        InvoiceItem[]
  PurchaseOrderItem  PurchaseOrderItem[]
  GoodsReceiptItem   GoodsReceiptItem[]
  InventoryCostLayer InventoryCostLayer[]
  quality_checks     QualityCheck[]

  @@unique([company_id, code])
  @@unique([company_id, barcode])
}

model ProductImage {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  product_id String  @db.ObjectId
  product    Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  image_url  String
  is_primary Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ProductDocument {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  product_id    String  @db.ObjectId
  product       Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_url  String
  document_type String
  title         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

// =======================
// ENTERPRISE ASSET MANAGEMENT (PHASE 4)
// =======================

model AssetCategory {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  company_id String          @db.ObjectId
  company    Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?         @db.ObjectId
  parent     AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   AssetCategory[] @relation("AssetCategoryHierarchy")

  name        String
  code        String?
  description String?
  icon        String?
  color       String?
  status      Boolean @default(true)

  assets AssetMaster[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model AssetMaster {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String        @db.ObjectId
  company      Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id  String        @db.ObjectId
  category     AssetCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id String?       @db.ObjectId

  assigned_user_id String? @db.ObjectId
  assigned_user    User?   @relation("UserAssets", fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  asset_code    String
  asset_name    String
  brand         String?
  model         String?
  serial_number String?
  barcode       String? @unique
  qr_code       String? @unique

  purchase_date  DateTime?
  purchase_price Float     @default(0)
  supplier_id    String?   @db.ObjectId

  current_value       Float   @default(0)
  useful_life         Int? // In months
  depreciation_method String? // Straight Line, Declining Balance

  location  String?
  status    String // ACTIVE, BORROWED, MAINTENANCE, BROKEN, DISPOSED, SOLD, LOST
  condition String // EXCELLENT, GOOD, FAIR, DAMAGED, BROKEN

  warranty_until DateTime?
  notes          String?
  image          String?
  manual_file    String?
  invoice_file   String?

  is_capitalized                      Boolean               @default(false)
  capitalization_date                 DateTime?
  residual_value                      Float                 @default(0)
  accumulated_depreciation            Float                 @default(0)
  asset_account_id                    String?
  accumulated_depreciation_account_id String?
  depreciation_expense_account_id     String?
  disposal_date                       DateTime?
  disposal_proceeds                   Float                 @default(0)
  asset_depreciations                 AssetDepreciation[]
  histories                           AssetHistory[]
  locations                           AssetLocation[]
  assignments                         AssetAssignment[]
  borrowings                          AssetBorrowing[]
  maintenances                        MaintenanceLog[]
  schedules                           MaintenanceSchedule[]
  documents                           AssetDocument[]
  depreciations                       DepreciationLog[]
  work_orders                         WorkOrder[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, asset_code])
}

model AssetHistory {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id     String      @db.ObjectId
  asset        AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action       String
  before_data  Json?
  after_data   Json?
  performed_by String      @db.ObjectId
  user         User        @relation("PerformedAssetHistories", fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  performed_at DateTime @default(now())
}

model AssetLocation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id      String      @db.ObjectId
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from_location String?
  to_location   String
  from_user     String?
  to_user       String?
  notes         String?

  created_by String   @db.ObjectId
  user       User     @relation("CreatedAssetLocations", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moved_at   DateTime @default(now())
}

model AssetAssignment {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id String      @db.ObjectId
  asset    AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id  String      @db.ObjectId
  user     User        @relation("AssignedAssets", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assigned_at DateTime  @default(now())
  returned_at DateTime?
  status      String // ACTIVE, RETURNED
  notes       String?
}

model AssetBorrowing {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id   String      @db.ObjectId
  asset      AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  borrower   String      @db.ObjectId
  user       User        @relation("BorrowedAssets", fields: [borrower], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department String?

  borrow_date        DateTime
  return_date        DateTime
  actual_return_date DateTime?

  status      String // PENDING, BORROWED, RETURNED, OVERDUE, CANCELLED
  approved_by String? @db.ObjectId
  approver    User?   @relation("ApprovedAssetBorrowings", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model MaintenanceLog {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id         String      @db.ObjectId
  asset            AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_type String // Preventive, Corrective, Emergency, Calibration, Inspection
  vendor           String?
  cost             Float       @default(0)
  description      String?

  before_photo String?
  after_photo  String?
  invoice      String?

  service_date      DateTime
  next_service_date DateTime?
  technician        String?
  status            String // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  created_by String @db.ObjectId
  user       User   @relation("CreatedMaintenanceLogs", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model MaintenanceSchedule {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id       String      @db.ObjectId
  asset          AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interval_type  String // DAYS, MONTHS, YEARS, USAGE_HOURS, KM
  interval_value Int

  last_schedule DateTime?
  next_schedule DateTime
  status        String // ACTIVE, PAUSED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model WorkOrder {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id         String      @db.ObjectId
  asset            AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wo_number        String      @unique
  title            String
  description      String?
  maintenance_type String
  priority         String // LOW, MEDIUM, HIGH, CRITICAL

  assigned_to String? @db.ObjectId
  technician  User?   @relation("AssignedWorkOrders", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)

  estimated_hours Float?
  actual_hours    Float?
  cost            Float  @default(0)

  status String // OPEN, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED

  started_at   DateTime?
  completed_at DateTime?

  created_by String @db.ObjectId
  user       User   @relation("CreatedWorkOrders", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
  company_id     String?        @db.ObjectId
}

model AssetDocument {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id      String      @db.ObjectId
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_type String // Manual, Invoice, Warranty, Certificate, Photo, License, Other
  file_name     String
  file_url      String

  uploaded_by String @db.ObjectId
  user        User   @relation("UploadedAssetDocuments", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  uploaded_at DateTime @default(now())
}

model DepreciationLog {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  asset_id      String      @db.ObjectId
  asset         AssetMaster @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period        String // e.g. "2026-07"
  opening_value Float
  depreciation  Float
  closing_value Float

  created_at DateTime @default(now())
}

model AuditLog {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String? @db.ObjectId
  user_id    String? @db.ObjectId
  ip_address String?
  browser    String?
  device     String?

  action    String
  entity    String
  entity_id String?

  before_data Json?
  after_data  Json?

  created_at DateTime @default(now())
}

// =======================
// INVENTORY & STOCK LEDGER (PHASE 3)
// =======================

model InventoryTransaction {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  company_id          String     @db.ObjectId
  company             Company    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_no      String
  transaction_type    String // IN, OUT, TRANSFER, ADJUSTMENT, OPNAME, RETURN
  warehouse_id        String     @db.ObjectId
  warehouse           Warehouse  @relation("TransactionWarehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target_warehouse_id String?    @db.ObjectId
  target_warehouse    Warehouse? @relation("TransactionTargetWarehouse", fields: [target_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reference_type      String?
  reference_id        String?
  status              String // Draft, Pending, Approved, Rejected, Cancelled
  transaction_date    DateTime
  notes               String?

  created_by    String    @db.ObjectId
  user_created  User      @relation("CreatedTransactions", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?   @db.ObjectId
  user_approved User?     @relation("ApprovedTransactions", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items InventoryTransactionItem[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, transaction_no])
}

model InventoryTransactionItem {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  transaction_id String               @db.ObjectId
  transaction    InventoryTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id     String               @db.ObjectId
  product        Product              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty            Int
  system_qty     Int?
  counted_qty    Int?
  difference     Int?
  unit_cost      Float                @default(0)
  subtotal       Float                @default(0)
  batch_number   String?
  expired_date   DateTime?
  notes          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model StockMovement {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String    @db.ObjectId
  warehouse_id String    @db.ObjectId
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id   String    @db.ObjectId
  product      Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transaction_type String // IN, OUT, TRANSFER, ADJUSTMENT, OPNAME, RETURN
  transaction_id   String? @db.ObjectId
  movement_type    String // IN, OUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_PLUS, ADJUSTMENT_MINUS, OPNAME, RETURN

  qty_in        Int @default(0)
  qty_out       Int @default(0)
  balance_after Int @default(0)

  unit_cost  Float @default(0)
  total_cost Float @default(0)

  batch_number     String?
  expired_date     DateTime?
  reference_number String?
  remarks          String?

  created_by String @db.ObjectId
  user       User   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at           DateTime               @default(now())
  InventoryCostLayer   InventoryCostLayer[]
  CostLayerConsumption CostLayerConsumption[]
}

model WarehouseStock {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String    @db.ObjectId
  warehouse_id String    @db.ObjectId
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_id   String    @db.ObjectId
  product      Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  current_stock   Int @default(0)
  reserved_stock  Int @default(0)
  available_stock Int @default(0)

  updated_at DateTime @updatedAt

  @@unique([company_id, warehouse_id, product_id])
}

// =======================
// FINANCE MANAGEMENT (PHASE 5)
// =======================

model CashAccount {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  company_id          String          @db.ObjectId
  company             Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                String
  name                String
  account_type        String // Cash, Bank, Petty Cash, Digital Wallet
  chart_of_account_id String?         @db.ObjectId
  chart_of_account    ChartOfAccount? @relation(fields: [chart_of_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency            String          @default("IDR")

  opening_balance Float   @default(0)
  current_balance Float   @default(0)
  status          Boolean @default(true)

  transactions    FinanceTransaction[]
  reconciliations Reconciliation[]
  petty_cashes    PettyCash[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, code])
}

model FinanceCategory {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  company_id String            @db.ObjectId
  company    Company           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id  String?           @db.ObjectId
  parent     FinanceCategory?  @relation("FinanceCatHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   FinanceCategory[] @relation("FinanceCatHierarchy")
  name       String
  type       String // Income, Expense, Transfer, Adjustment
  color      String?
  icon       String?
  status     Boolean           @default(true)

  items       FinanceTransactionItem[]
  budgets     Budget[]
  ExpenseItem ExpenseItem[]
}

model FinanceTransaction {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  company_id       String      @db.ObjectId
  company          Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_id     String?     @db.ObjectId
  warehouse        Warehouse?  @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_no   String
  transaction_type String // Cash In, Cash Out, Transfer, Expense, Income, Adjustment
  cash_account_id  String      @db.ObjectId
  cash_account     CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reference_type   String?
  reference_id     String?
  transaction_date DateTime
  status           String // Draft, Pending, Approved, Rejected, Cancelled, Reversed
  description      String?
  total_amount     Float    @default(0)

  created_by    String    @db.ObjectId
  user_created  User      @relation("CreatedFinanceTx", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?   @db.ObjectId
  user_approved User?     @relation("ApprovedFinanceTx", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items     FinanceTransactionItem[]
  documents FinanceDocument[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([company_id, transaction_no])
}

model FinanceTransactionItem {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  transaction_id String             @db.ObjectId
  transaction    FinanceTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id    String             @db.ObjectId
  category       FinanceCategory    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount         Float
  tax            Float              @default(0)
  description    String?
}

model FinanceDocument {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  transaction_id String             @db.ObjectId
  transaction    FinanceTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_type  String
  file_url       String

  uploaded_by String   @db.ObjectId
  user        User     @relation("UploadedFinanceDocs", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploaded_at DateTime @default(now())
}

model PettyCash {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  company_id      String      @db.ObjectId
  company         Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cash_account_id String      @db.ObjectId
  cash_account    CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee_id     String      @db.ObjectId
  employee        User        @relation("PettyCashEmployee", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  opening_balance Float
  current_balance Float
  status          String // ACTIVE, CLOSED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Budget {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  company_id    String          @db.ObjectId
  company       Company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category_id   String          @db.ObjectId
  category      FinanceCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department_id String?         @db.ObjectId
  period        String // e.g. "2026-07"

  budget_amount    Float
  used_amount      Float  @default(0)
  remaining_amount Float
  status           String // ACTIVE, EXHAUSTED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model Reconciliation {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  company_id      String      @db.ObjectId
  company         Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cash_account_id String      @db.ObjectId
  cash_account    CashAccount @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period          String // e.g. "2026-07"

  system_balance   Float
  physical_balance Float
  difference       Float

  approved_by String? @db.ObjectId
  approver    User?   @relation("ApprovedReconciliations", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String // PENDING, APPROVED, ADJUSTED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

// =======================
// ACCOUNTING & GENERAL LEDGER (PHASE 6)
// =======================

model AccountType {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id     String  @db.ObjectId
  company        Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code           String
  name           String
  normal_balance String // Debit, Credit
  description    String?

  accounts ChartOfAccount[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, code])
}

model ChartOfAccount {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  company_id      String           @db.ObjectId
  company         Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_id       String?          @db.ObjectId
  parent          ChartOfAccount?  @relation("CoA_Hierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        ChartOfAccount[] @relation("CoA_Hierarchy")
  account_type_id String           @db.ObjectId
  account_type    AccountType      @relation(fields: [account_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  account_code       String
  account_name       String
  currency           String  @default("IDR")
  allow_manual_entry Boolean @default(true)
  is_header          Boolean @default(false)
  status             Boolean @default(true)

  journal_items JournalEntryItem[]

  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  deleted_at  DateTime?
  CashAccount CashAccount[]

  @@unique([company_id, account_code])
}

model JournalEntry {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  company_id      String   @db.ObjectId
  company         Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_no      String
  reference_type  String // INVENTORY, ASSET, FINANCE, MANUAL
  reference_id    String?
  idempotency_key String?  @unique
  journal_date    DateTime
  description     String?
  status          String // Draft, Pending, Approved, Posted, Closed

  created_by    String    @db.ObjectId
  user_created  User      @relation("CreatedJournals", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by   String?   @db.ObjectId
  user_approved User?     @relation("ApprovedJournals", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_at   DateTime?

  items          JournalEntryItem[]
  adjustments    JournalAdjustment[]
  reversals_orig JournalReversal[]   @relation("OriginalJournal")
  reversals_rev  JournalReversal[]   @relation("ReverseJournal")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, journal_no])
}

model JournalEntryItem {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  journal_entry_id String         @db.ObjectId
  journal_entry    JournalEntry   @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account_id       String         @db.ObjectId
  account          ChartOfAccount @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?
}

model FiscalYear {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  company_id String   @db.ObjectId
  company    Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  year       Int
  start_date DateTime
  end_date   DateTime
  status     String // OPEN, CLOSED

  closed_at DateTime?
  closed_by String?   @db.ObjectId
  closer    User?     @relation("ClosedFiscalYears", fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())

  @@unique([company_id, year])
}

model AccountingPeriod {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  company_id String   @db.ObjectId
  company    Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  month      Int
  year       Int
  start_date DateTime
  end_date   DateTime
  status     String // OPEN, CLOSED

  created_at DateTime @default(now())

  @@unique([company_id, month, year])
}

model JournalAdjustment {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  company_id       String       @db.ObjectId
  company          Company      @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entry_id String       @db.ObjectId
  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason           String

  created_by  String  @db.ObjectId
  creator     User    @relation("CreatedAdjustments", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approved_by String? @db.ObjectId
  approver    User?   @relation("ApprovedAdjustments", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

model JournalReversal {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String  @db.ObjectId
  company    Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  original_journal_id String       @db.ObjectId
  original_journal    JournalEntry @relation("OriginalJournal", fields: [original_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reverse_journal_id  String       @db.ObjectId
  reverse_journal     JournalEntry @relation("ReverseJournal", fields: [reverse_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reason     String
  created_by String @db.ObjectId
  creator    User   @relation("CreatedReversals", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

// =======================
// DASHBOARD & BUSINESS INTELLIGENCE (PHASE 7)
// =======================

model DashboardLayout {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id  String  @db.ObjectId
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id     String  @db.ObjectId
  user        User    @relation("DashboardLayouts", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String // "Manager Layout", "Finance Default"
  is_default  Boolean @default(false)
  layout_data Json // JSON array of widget coordinates and sizes

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, name])
}

model DashboardWidget {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id  String  @db.ObjectId
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  widget_type String // e.g. "LineChart", "PieChart", "KPICard"
  data_source String // e.g. "api/analytics/net-profit"
  title       String
  config      Json? // Optional filter configs saved by user

  user_id String @db.ObjectId
  user    User   @relation("DashboardWidgets", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model BusinessInsight {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String  @db.ObjectId
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  insight_type String // "Warning", "Recommendation", "Achievement"
  title        String
  description  String
  module       String // "Inventory", "Asset", "Finance", "Accounting"
  priority     String // "LOW", "MEDIUM", "HIGH"
  status       String // "UNREAD", "READ", "RESOLVED"

  created_at DateTime @default(now())
}

// =======================
// REPORTING & DOCUMENT CENTER (PHASE 8)
// =======================

model ReportSchedule {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id  String  @db.ObjectId
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  report_type String // "Inventory", "Finance", "Accounting"
  cron_expr   String // e.g. "0 8 * * *"
  recipients  String // comma separated emails
  status      Boolean @default(true)
  created_by  String  @db.ObjectId
  user        User    @relation("ScheduledReports", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ReportExportLog {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String  @db.ObjectId
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_type  String
  format       String // "PDF", "EXCEL", "CSV"
  status       String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  file_url     String?
  error_msg    String?
  requested_by String  @db.ObjectId
  user         User    @relation("ExportLogs", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  started_at   DateTime  @default(now())
  completed_at DateTime?
}

model DocumentMaster {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id  String  @db.ObjectId
  company     Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_no String  @unique
  title       String
  category    String // "Invoice", "Purchase Order", "Contract"
  tags        String? // comma separated, e.g. "Urgent,Finance"
  status      String // "ACTIVE", "ARCHIVED"

  uploaded_by String @db.ObjectId
  user        User   @relation("UploadedDocuments", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  versions DocumentVersion[]
  shares   DocumentShareLink[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, document_no])
}

model DocumentVersion {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  document_master_id String         @db.ObjectId
  document_master    DocumentMaster @relation(fields: [document_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version_number     Int
  file_url           String
  file_size          Int // in bytes
  mime_type          String
  uploaded_by        String         @db.ObjectId
  user               User           @relation("UploadedDocumentVersions", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
}

model DocumentShareLink {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  document_master_id String         @db.ObjectId
  document_master    DocumentMaster @relation(fields: [document_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  token              String         @unique
  password_hash      String?
  expired_at         DateTime

  created_by String   @db.ObjectId
  user       User     @relation("CreatedShareLinks", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_at DateTime @default(now())
}

// =======================
// WORKFLOW AUTOMATION PLATFORM (PHASE 9)
// =======================

model WorkflowMaster {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id    String  @db.ObjectId
  company       Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name          String
  description   String?
  module        String // "Inventory", "Finance", "Asset"
  trigger_event String // e.g. "InventoryTransaction.Created"
  status        Boolean @default(true)
  version       Int     @default(1)

  nodes WorkflowNode[]
  edges WorkflowEdge[]
  logs  AutomationLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model WorkflowNode {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  workflow_master_id String         @db.ObjectId
  workflow_master    WorkflowMaster @relation(fields: [workflow_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  node_type          String // "Start", "Condition", "Approval", "Notification", "Task", "End"
  node_name          String
  config             Json // Rules, Emails, Roles, Conditions (AND/OR/>/<)
  ui_position        Json // {x: 100, y: 200} for Visual Editor

  created_at DateTime @default(now())
}

model WorkflowEdge {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  workflow_master_id String         @db.ObjectId
  workflow_master    WorkflowMaster @relation(fields: [workflow_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_node_id     String
  target_node_id     String
  condition_label    String? // e.g. "True", "False", "Approved", "Rejected"

  created_at DateTime @default(now())
}

model ApprovalRequest {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id   String  @db.ObjectId
  company      Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module       String // "Finance", "Inventory"
  reference_id String // ID dari transaksi
  title        String
  description  String?
  status       String // "PENDING", "APPROVED", "REJECTED", "ESCALATED"

  current_step  Int     @default(1)
  assigned_role String? // Jika approval berdasarkan role
  assigned_user String? @db.ObjectId // Jika approval spesifik ke user
  assignee      User?   @relation("PendingApprovals", fields: [assigned_user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  logs ApprovalLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_requests LeaveRequest[]
}

model ApprovalLog {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  approval_request_id String          @db.ObjectId
  approval_request    ApprovalRequest @relation(fields: [approval_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
